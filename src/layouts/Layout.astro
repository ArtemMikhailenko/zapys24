---
import '../styles/global.css';
import SignupModal from '../components/SignupModal.astro';

const {
  title = 'Zapys24 — CRM і онлайн-запис для бізнесу',
  description = 'Zapys24 — українська CRM з онлайн-записом, клієнтською базою, аналітикою та фінансами. Керуйте сервісним бізнесом легко. 14 днів безкоштовно.',
  image = '/og-image.jpg',
  noindex = false,
  preload = null,
  // Art-directed portrait crop for phones. When set, `preload` is scoped to
  // wider screens so the browser only ever fetches the one it will paint.
  preloadMobile = null,
} = Astro.props;

// Unbounded (headings) and Manrope (body) render arbitrary copy, so they need
// the full character set.
const FONTS =
  'https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700&display=swap';

// Caveat is decorative: it only ever renders the short handwritten captions in
// `.hand` (~13 phrases, 34 distinct glyphs) — yet the full Cyrillic face cost
// 149KB, i.e. 53% of all font weight on the page. `text=` makes Google return a
// subset containing just these glyphs: 149KB → 67KB. Only weight 600 is used.
// NOTE: a `.hand` caption using a character outside this set falls back to
// generic cursive silently — add the character here if that ever happens.
const CAVEAT_GLYPHS =
  "АБВГҐДЕЄЖЗИІЇЙКЛМНОПРСТУФХЦЧШЩЬЮЯабвгґдеєжзиіїйклмнопрстуфхцчшщьюяABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 '\"?!.,:;()—–-+%₴";
const CAVEAT = `https://fonts.googleapis.com/css2?family=Caveat:wght@600&text=${encodeURIComponent(CAVEAT_GLYPHS)}&display=swap`;

// Self-referencing canonical + absolute OG/Twitter image, built from `site`.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://zapys24.com/#organization',
      name: 'Zapys24',
      url: 'https://zapys24.com',
      logo: {
        '@type': 'ImageObject',
        url: 'https://zapys24.com/icon-512.png',
        width: 512,
        height: 512,
      },
      description: 'Платформа онлайн-запису та CRM для бізнесу',
      foundingDate: '2024',
      areaServed: { '@type': 'Country', name: 'Україна' },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        availableLanguage: ['Ukrainian'],
        areaServed: 'UA',
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://zapys24.com/#website',
      url: 'https://zapys24.com',
      name: 'Zapys24',
      description: 'Єдина платформа онлайн-запису та CRM для бізнесу',
      publisher: { '@id': 'https://zapys24.com/#organization' },
      inLanguage: 'uk-UA',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://zapys24.com/#software',
      name: 'Zapys24',
      applicationCategory: 'BusinessApplication',
      applicationSubCategory: 'Appointment Scheduling',
      operatingSystem: 'Web, iOS, Android',
      description:
        'CRM та платформа онлайн-запису для салонів краси, кінних клубів та інших сервісних бізнесів в Україні.',
      inLanguage: 'uk-UA',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'UAH',
        availability: 'https://schema.org/InStock',
      },
      provider: { '@id': 'https://zapys24.com/#organization' },
      featureList:
        'Онлайн-запис 24/7, CRM клієнтська база, авто-нагадування, мобільний застосунок, облік фінансів, аналітика та звіти, керування персоналом',
    },
  ],
};
---

<!DOCTYPE html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- LCP image preload (per-page). `media` keeps the two art-directed crops
         mutually exclusive — without it the browser preloads both. -->
    {preload && (
      <link
        rel="preload"
        as="image"
        href={preload}
        fetchpriority="high"
        media={preloadMobile ? '(min-width: 601px)' : undefined}
      />
    )}
    {preloadMobile && (
      <link
        rel="preload"
        as="image"
        href={preloadMobile}
        fetchpriority="high"
        media="(max-width: 600px)"
      />
    )}

    <!-- SEO -->
    <link rel="canonical" href={canonicalURL} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#7C3AED" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Icons & manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Zapys24" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Zapys24" />
    <meta property="og:locale" content="uk_UA" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Hreflang (single-language site) -->
    <link rel="alternate" hreflang="uk" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <!-- Fonts — non-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={FONTS} onload="this.onload=null;this.rel='stylesheet'" />
    <link rel="preload" as="style" href={CAVEAT} onload="this.onload=null;this.rel='stylesheet'" />
    <noscript>
      <link rel="stylesheet" href={FONTS} />
      <link rel="stylesheet" href={CAVEAT} />
    </noscript>

    <!-- Analytics: queue now (no network), load the heavy parts after `load`.
         NOTE: gtag.js below is what actually fires GA4 — the GTM container has
         NO GA4 tag (verified: with this include removed, GTM loads and consent
         is granted, yet gtag.js never loads and GA records nothing). Because
         gtag.js and GTM are both present they cross-load each other's config,
         so gtag.js is fetched twice (~163KB each). Fixing that properly is a
         GTM-side decision — see the note in the SEO memory. Do not just delete
         this include: it silently kills analytics. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag("js", new Date());
      gtag("config", "G-P09ZFMQ77Z", { cookie_domain: "zapys24.com" });

      // GTM + GA + the Usercentrics CMP are ~400KB of third-party that used to
      // compete with the hero image for bandwidth (mobile LCP was 10s). They are
      // injected only after `load`, once the page has painted. The gtag calls
      // queued above replay as soon as gtag.js arrives, so the pageview survives.
      (function () {
        var booted = false;
        function inject(src, attrs) {
          var s = document.createElement("script");
          s.async = true;
          s.src = src;
          if (attrs)
            Object.keys(attrs).forEach(function (k) {
              s.setAttribute(k, attrs[k]);
            });
          document.head.appendChild(s);
        }
        function boot() {
          if (booted) return;
          booted = true;
          dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
          inject("https://www.googletagmanager.com/gtm.js?id=GTM-WH7P6TT5");
          inject("https://www.googletagmanager.com/gtag/js?id=G-P09ZFMQ77Z");
          inject("https://app.usercentrics.eu/browser-ui/latest/loader.js", {
            id: "usercentrics-cmp",
            "data-settings-id": "DVrGVN1PlCdp7S",
          });
        }
        if (document.readyState === "complete") boot();
        else window.addEventListener("load", boot, { once: true });
      })();
    </script>

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Deferred media. Two cases attributes can't solve on their own:
         • CSS background-image has no loading="lazy" at all, so a below-fold
           photo downloads the moment its rule applies;
         • Chrome's lazy threshold still pulls <img> that are ~1-3 screens down.
         Both starve the LCP image of bandwidth on mobile, so we hand the URL
         over only ~300px before the element scrolls into view. Hero art is
         deliberately NOT marked up this way — it must stay eager. -->
    <script is:inline>
      (function () {
        function reveal(el) {
          if (el.dataset.bg) {
            el.style.backgroundImage = "url(" + el.dataset.bg + ")";
            el.removeAttribute("data-bg");
          }
          if (el.dataset.src) {
            el.src = el.dataset.src;
            el.removeAttribute("data-src");
          }
        }
        function init() {
          var els = document.querySelectorAll("[data-bg],[data-src]");
          if (!("IntersectionObserver" in window)) {
            Array.prototype.forEach.call(els, reveal);
            return;
          }
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (!e.isIntersecting) return;
                reveal(e.target);
                io.unobserve(e.target);
              });
            },
            { rootMargin: "300px 0px" },
          );
          Array.prototype.forEach.call(els, function (el) {
            io.observe(el);
          });
        }
        if (document.readyState === "loading")
          document.addEventListener("DOMContentLoaded", init);
        else init();

        // Hero carousel slides 2-3 sit *inside* the viewport at opacity:0, so an
        // observer would fire on them instantly. They're only seen seconds later,
        // so they wait for `load` instead — that keeps slide 1 (the LCP) alone on
        // the wire.
        window.addEventListener(
          "load",
          function () {
            // <source> first: setting img.src on a <picture> whose sources are
            // still empty would lock in the desktop file on phones.
            var srcs = document.querySelectorAll("source[data-srcset-late]");
            Array.prototype.forEach.call(srcs, function (el) {
              el.srcset = el.getAttribute("data-srcset-late");
              el.removeAttribute("data-srcset-late");
            });
            var late = document.querySelectorAll("img[data-src-late]");
            Array.prototype.forEach.call(late, function (el) {
              el.src = el.getAttribute("data-src-late");
              el.removeAttribute("data-src-late");
            });
          },
          { once: true },
        );
      })();
    </script>

    <script is:inline defer src="/main.js?v=3"></script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WH7P6TT5"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <div class="mesh">
      <div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div>
    </div>
    <div class="grain"></div>
    <slot />
    <SignupModal />

    <!-- Zapys24 analytics: visit + first-touch UTM (site=main) -->
    <script>
      (() => {
        try {
          const API = "https://api.zapys24.com/api/v1";
          const VID_KEY = "z_visitor_id";
          const ATTR_KEY = "z_first_attr";

          const uuid = () =>
            crypto && crypto.randomUUID
              ? crypto.randomUUID()
              : `${Date.now()}-${Math.random().toString(16).slice(2)}`;

          let visitorId = localStorage.getItem(VID_KEY);
          if (!visitorId) {
            visitorId = uuid();
            localStorage.setItem(VID_KEY, visitorId);
          }

          const p = new URLSearchParams(location.search);
          const val = (k) => p.get(k) || undefined;
          const utm = {
            utmSource: val("utm_source"),
            utmMedium: val("utm_medium"),
            utmCampaign: val("utm_campaign"),
            utmTerm: val("utm_term"),
            utmContent: val("utm_content"),
          };
          const hasUtm = !!(utm.utmSource || utm.utmMedium || utm.utmCampaign);

          if (hasUtm && !localStorage.getItem(ATTR_KEY)) {
            localStorage.setItem(
              ATTR_KEY,
              JSON.stringify({
                visitorId,
                site: "main",
                referrer: document.referrer || undefined,
                landingPath: location.pathname + location.search,
                ...utm,
              }),
            );
          }

          // text/plain → CORS "simple request" (no preflight)
          fetch(`${API}/analytics/visit`, {
            method: "POST",
            headers: { "Content-Type": "text/plain" },
            body: JSON.stringify({
              visitorId,
              site: "main",
              path: location.pathname + location.search,
              referrer: document.referrer || undefined,
              ...utm,
            }),
            keepalive: true,
            credentials: "omit",
            mode: "no-cors",
          }).catch(() => {});
        } catch {
          /* analytics must never break the page */
        }
      })();
    </script>
  </body>
</html>
