---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>';
const back = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>';
const S = (p) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;
const IC = {
  clock: S('<path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"/><path d="M12 12l3 2"/><path d="M12 7v5"/>'),
  shield:S('<path d="M12 3a12 12 0 0 0 8 3a12 12 0 0 1 -8 15a12 12 0 0 1 -8 -15a12 12 0 0 0 8 -3"/><path d="M9 12l2 2l4 -4"/>'),
  user:  S('<path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"/><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/>'),
  mail:  S('<path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"/><path d="M3 7l9 6l9 -6"/>'),
  list:  S('<path d="M9 6l11 0"/><path d="M9 12l11 0"/><path d="M9 18l11 0"/><path d="M5 6l0 .01"/><path d="M5 12l0 .01"/><path d="M5 18l0 .01"/>'),
  chat:  S('<path d="M4 21v-13a3 3 0 0 1 3 -3h10a3 3 0 0 1 3 3v6a3 3 0 0 1 -3 3h-9l-4 4"/>'),
  inbox: S('<path d="M4 13a2 2 0 0 1 2 -2h1l2 3h6l2 -3h1a2 2 0 0 1 2 2v5a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"/><path d="M12 3v9"/><path d="M9 8l3 3l3 -3"/>'),
  route: S('<path d="M8 6h11"/><path d="M8 12h11"/><path d="M8 18h11"/><path d="M4 6a1 1 0 1 0 0 -.01"/><path d="M4 12a1 1 0 1 0 0 -.01"/><path d="M4 18a1 1 0 1 0 0 -.01"/>'),
  reply: S('<path d="M8 9l-4 4l4 4"/><path d="M4 13h11a5 5 0 0 0 5 -5v-2"/>'),
  check: S('<path d="M5 12l5 5l10 -10"/>'),
};
const fb = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 22v-8h3l1-4h-4V8c0-1.1.3-2 2-2h2V2.2C18.6 2.1 17.4 2 16 2c-3 0-5 1.8-5 5.2V10H8v4h3v8h2z"/></svg>';

const ways = [
  { nm:'Telegram',           s:'Найшвидший спосіб',   img:'telegram.svg',  bg:'#26A5E4' },
  { nm:'Instagram',          s:'Пишіть у Direct',     img:'instagram.svg', bg:'linear-gradient(135deg,#F58529,#DD2A7B,#8134AF)' },
  { nm:'Email',              s:'Підтримка та запити', ic:IC.mail,          bg:'linear-gradient(135deg,#7C3AED,#A96BF0)' },
  { nm:'Viber',              s:'Зручний чат',         img:'viber.svg',     bg:'#7360F2' },
  { nm:'Facebook Messenger', s:'Месенджер',           raw:fb,              bg:'#1877F2' },
];
const steps = [
  { ic:IC.inbox, t:'Ми отримуємо ваше повідомлення', d:'Миттєво отримуємо та реєструємо запит' },
  { ic:IC.route, t:'Аналізуємо запит', d:'Призначаємо відповідного спеціаліста' },
  { ic:IC.reply, t:'Надаємо відповідь', d:'Відповідаємо у середньому за 7 хвилин' },
  { ic:IC.check, t:'Допомагаємо вирішити', d:'Працюємо до повного вирішення вашого питання' },
];
const faqs = [
  { q:'Як швидко ви відповідаєте?', a:'У середньому за 7 хвилин у робочі години. У месенджерах — ще швидше.' },
  { q:'Як залишити запит на підтримку?', a:'Заповніть форму на цій сторінці — і ми зв’яжемося з вами.' },
  { q:'Які ваші робочі години?', a:'Підтримка на зв’язку 24/7. Відділ продажів — Пн–Пт, 9:00–18:00.' },
  { q:'Чи допомагаєте з перенесенням даних?', a:'Так, ми безкоштовно допоможемо перенести клієнтів, записи та історію.' },
  { q:'Чи є у вас офлайн-офіс?', a:'Так, наш офіс у Києві, вул. Велика Васильківська, 72.' },
  { q:'Де можна слідкувати за новинами?', a:'В Instagram, Telegram та нашому блозі.' },
];
---

<Layout title="Напишіть нам — Zapys24">
  <Nav />

  <!-- HERO -->
  <section class="np-hero reveal">
    <div class="np-hero-photo" style="background-image:url(/img/contact-hero.webp)"></div>
    <div class="wrap np-hero-in">
      <div class="np-hero-l">
        <a class="np-back" href="/kontakty"><span set:html={back}></span>Назад</a>
        <h1 class="dis np-h1">Напишіть нам&nbsp;—<br>ми на <span class="ac">зв'язку</span></h1>
        <p class="np-lead">Заповніть форму, і ми відповімо вам найближчим часом. Без ботів та автовідповідачів.</p>
        <div class="np-chips">
          <div class="kx-chip"><span class="kx-chip-ic" set:html={IC.clock}></span><div>Середній час відповіді<b>7 хвилин</b></div></div>
          <div class="kx-chip"><span class="kx-chip-ic np-chip-g" set:html={IC.shield}></span><div>Відповідаємо<b>24/7</b></div></div>
        </div>
      </div>
      <div class="np-hero-note">
        <p class="hand">Ми відповідаємо<br>швидко!</p>
        <svg class="np-note-ar" viewBox="0 0 118 82" fill="none" aria-hidden="true"><path d="M10 14 C54 6 96 22 103 60" stroke="var(--violet)" stroke-width="2.2" stroke-linecap="round"/><path d="M103 60 l-3 -17 M103 60 l-16 -6" stroke="var(--violet)" stroke-width="2.2" stroke-linecap="round"/></svg>
      </div>
    </div>
  </section>

  <!-- FORM + SIDE -->
  <section class="kr-sec wrap reveal" id="form">
    <div class="np-grid">
      <form class="np-form" onsubmit="return false">
        <h2 class="np-form-h">Розкажіть, чим можемо допомогти</h2>
        <div class="np-row2">
          <label class="np-fld"><span>Ваше ім'я</span><input type="text" placeholder="Введіть ваше ім'я" /></label>
          <label class="np-fld"><span>Email</span><input type="email" placeholder="you@example.com" /></label>
        </div>
        <label class="np-fld"><span>Категорія звернення</span>
          <div class="np-sel"><select><option value="" disabled selected>Оберіть категорію</option><option>Продажі</option><option>Підтримка</option><option>Партнерство</option><option>Преса</option></select><span class="np-sel-chev">⌄</span></div>
        </label>
        <label class="np-fld"><span>Тема повідомлення</span><input type="text" placeholder="Коротко опишіть тему" /></label>
        <label class="np-fld"><span>Повідомлення</span><textarea rows="5" placeholder="Детально опишіть ваш запит або питання"></textarea></label>
        <div class="np-drop"><span class="np-drop-ic" set:html={IC.inbox}></span><div><b>Додати файл <i>(необов'язково)</i></b><span>Перетягніть файл сюди або натисніть для вибору</span><small>Формати: JPG, PNG, PDF, до 10MB</small></div></div>
        <div class="np-form-foot">
          <button class="np-form-btn" type="submit">Надіслати повідомлення<span class="fbtn-ar" set:html={arrow}></span></button>
          <div class="np-form-note"><span set:html={IC.shield}></span>Ваші дані захищені та не передаються третім особам</div>
        </div>
      </form>

      <aside class="np-side">
        <div class="np-ways">
          <h3 class="np-side-h">Інші способи зв'язку</h3>
          {ways.map(w => (
            <a class="np-way" href="#">
              <span class="np-way-ic" style={`background:${w.bg}`}>{w.img ? <img src={`/img/logos/${w.img}`} alt={w.nm} /> : <span class="np-way-svg" set:html={w.raw || w.ic}></span>}</span>
              <div class="np-way-tx"><b>{w.nm}</b><span>{w.s}</span></div>
              <span class="np-way-ar" set:html={arrow}></span>
            </a>
          ))}
        </div>
        <div class="np-urgent">
          <h3 class="np-urgent-h">Потрібна термінова допомога?</h3>
          <p>Скористайтесь онлайн-чатом — наші спеціалісти вже готові допомогти.</p>
          <a class="np-urgent-btn" href="#"><span set:html={IC.chat}></span>Відкрити чат</a>
          <div class="np-online">
            <div class="np-avs"><span style="background-image:url(/img/quote.webp)"></span><span style="background-image:url(/img/model.webp)"></span><span style="background-image:url(/img/faq3.webp)"></span></div>
            <span class="np-online-tx"><i class="kx-dot"></i>Зараз онлайн 3 спеціалісти</span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- STEPS -->
  <section class="np-steps-sec reveal">
    <div class="wrap">
      <div class="kicker kx-kick">Процес</div>
      <h2 class="sh kx-ctr-h">Що відбувається після <span class="ac">відправки?</span></h2>
      <div class="np-steps">
        <div class="np-steps-line"></div>
        {steps.map((s,i) => (
          <div class="np-step">
            <span class="np-step-ic" set:html={s.ic}></span>
            <b>{s.t}</b>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="kr-sec wrap reveal">
    <div class="np-faq-head"><h2 class="sh">Часті <span class="ac">питання</span></h2><a class="np-faq-all" href="/#faq">Переглянути всі питання<span class="fbtn-ar" set:html={arrow}></span></a></div>
    <div class="kx-faq">
      {faqs.map((f,i) => (
        <details class="kc-faq-item" open={i===0}>
          <summary>{f.q}<span class="kx-faq-chev">⌄</span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="reveal final-sec">
    <div class="final">
      <div class="final-in">
        <h2 class="dis">Готові почати?</h2>
        <p>Приєднуйтесь до 1200+ компаній, які вже довіряють свій бізнес Zapys24.</p>
        <div class="fcta"><a class="fbtn" href="#">Спробувати безкоштовно<span class="fbtn-ar" set:html={arrow}></span></a></div>
        <div class="fnote">14 днів безкоштовно · Без картки</div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
