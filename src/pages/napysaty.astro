---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import {
  CONTACTS,
  EMAIL,
  PHONE_DISPLAY,
  TELEGRAM_HANDLE,
} from "../data/contacts";

const arrow =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>';
const back =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>';
const S = (p) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;
const IC = {
  clock: S(
    '<path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"/><path d="M12 12l3 2"/><path d="M12 7v5"/>',
  ),
  shield: S(
    '<path d="M12 3a12 12 0 0 0 8 3a12 12 0 0 1 -8 15a12 12 0 0 1 -8 -15a12 12 0 0 0 8 -3"/><path d="M9 12l2 2l4 -4"/>',
  ),
  user: S(
    '<path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"/><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/>',
  ),
  mail: S(
    '<path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"/><path d="M3 7l9 6l9 -6"/>',
  ),
  phone: S(
    '<path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2"/>',
  ),
  list: S(
    '<path d="M9 6l11 0"/><path d="M9 12l11 0"/><path d="M9 18l11 0"/><path d="M5 6l0 .01"/><path d="M5 12l0 .01"/><path d="M5 18l0 .01"/>',
  ),
  chat: S(
    '<path d="M4 21v-13a3 3 0 0 1 3 -3h10a3 3 0 0 1 3 3v6a3 3 0 0 1 -3 3h-9l-4 4"/>',
  ),
  inbox: S(
    '<path d="M4 13a2 2 0 0 1 2 -2h1l2 3h6l2 -3h1a2 2 0 0 1 2 2v5a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"/><path d="M12 3v9"/><path d="M9 8l3 3l3 -3"/>',
  ),
  route: S(
    '<path d="M8 6h11"/><path d="M8 12h11"/><path d="M8 18h11"/><path d="M4 6a1 1 0 1 0 0 -.01"/><path d="M4 12a1 1 0 1 0 0 -.01"/><path d="M4 18a1 1 0 1 0 0 -.01"/>',
  ),
  reply: S('<path d="M8 9l-4 4l4 4"/><path d="M4 13h11a5 5 0 0 0 5 -5v-2"/>'),
  check: S('<path d="M5 12l5 5l10 -10"/>'),
};
const fb =
  '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 22v-8h3l1-4h-4V8c0-1.1.3-2 2-2h2V2.2C18.6 2.1 17.4 2 16 2c-3 0-5 1.8-5 5.2V10H8v4h3v8h2z"/></svg>';

const ways = [
  {
    nm: "Telegram",
    s: TELEGRAM_HANDLE,
    href: CONTACTS.telegram,
    img: "telegram.svg",
    bg: "#26A5E4",
  },
  {
    nm: "Instagram",
    s: "Пишіть у Direct",
    href: CONTACTS.instagram,
    img: "instagram.svg",
    bg: "linear-gradient(135deg,#F58529,#DD2A7B,#8134AF)",
  },
  {
    nm: "Email",
    s: EMAIL,
    href: CONTACTS.email,
    ic: IC.mail,
    bg: "linear-gradient(135deg,#7C3AED,#A96BF0)",
  },
  {
    nm: "Viber",
    s: PHONE_DISPLAY,
    href: CONTACTS.viber,
    img: "viber.svg",
    bg: "#7360F2",
  },

  {
    nm: "Телефон",
    s: PHONE_DISPLAY,
    href: CONTACTS.phone,
    ic: IC.phone,
    bg: "linear-gradient(135deg,#16A34A,#0E8C3F)",
  },
];
const steps = [
  {
    ic: IC.inbox,
    t: "Ми отримуємо ваше повідомлення",
    d: "Миттєво отримуємо та реєструємо запит",
  },
  {
    ic: IC.route,
    t: "Аналізуємо запит",
    d: "Призначаємо відповідного спеціаліста",
  },
  {
    ic: IC.reply,
    t: "Надаємо відповідь",
    d: "Відповідаємо у середньому за 10 хвилин",
  },
  {
    ic: IC.check,
    t: "Допомагаємо вирішити",
    d: "Працюємо до повного вирішення вашого питання",
  },
];
const faqs = [
  {
    q: "Як швидко ви відповідаєте?",
    a: "У середньому за 10 хвилин у робочі години Пн–Пт, 9:00–18:00. У месенджерах — ще швидше.",
  },
  {
    q: "Як залишити запит на підтримку?",
    a: "Натисніть «Написати нам», заповніть коротку форму — і ми зв’яжемося з вами.",
  },
  {
    q: "Які ваші робочі години?",
    a: "Підтримка на зв’язку 24/7. Відділ продажів — Пн–Пт, 9:00–18:00.",
  },
  {
    q: "Чи можна замовити онлайн-зустріч?",
    a: "Так, заплануйте 30-хвилинну онлайн-зустріч із нашою командою для демонстрації платформи або консультації.",
  },
  {
    q: "Де можна слідкувати за новинами?",
    a: "В Instagram, Telegram та нашому блозі — там анонси оновлень і поради.",
  },
];
---

<Layout title="Напишіть нам — Zapys24">
  <Nav />

  <!-- HERO -->
  <section class="np-hero reveal">
    <div
      class="np-hero-photo"
      style="background-image:url(/img/contact-hero.webp)"
    >
    </div>
    <div class="wrap np-hero-in">
      <div class="np-hero-l">
        <a class="np-back" href="/kontakty"><span set:html={back} />Назад</a>
        <h1 class="dis np-h1">
          Напишіть нам&nbsp;—<br />ми на <span class="ac">зв'язку</span>
        </h1>
        <p class="np-lead">
          Заповніть форму, і ми відповімо вам найближчим часом. Без ботів та
          автовідповідачів. А ще можна забронювати <a
            class="np-lead-link"
            href="https://calendly.com/zapys24/30min?month=2026-07"
            target="_blank"
            rel="noopener">онлайн-зустріч</a
          > із нашою командою.
        </p>
        <div class="np-chips">
          <div class="kx-chip">
            <span class="kx-chip-ic" set:html={IC.clock} /><div>
              Середній час відповіді<b>10 хвилин</b>
            </div>
          </div>
          <div class="kx-chip">
            <span class="kx-chip-ic np-chip-g" set:html={IC.shield} /><div>
              Відповідаємо<b>24/7</b>
            </div>
          </div>
        </div>
      </div>
      <div class="np-hero-note">
        <p class="hand">Ми відповідаємо<br />швидко!</p>
        <svg
          class="np-note-ar"
          viewBox="0 0 118 82"
          fill="none"
          aria-hidden="true"
          ><path
            d="M10 14 C54 6 96 22 103 60"
            stroke="var(--violet)"
            stroke-width="2.2"
            stroke-linecap="round"></path><path
            d="M103 60 l-3 -17 M103 60 l-16 -6"
            stroke="var(--violet)"
            stroke-width="2.2"
            stroke-linecap="round"></path></svg
        >
      </div>
    </div>
  </section>

  <!-- FORM + SIDE -->
  <section class="kr-sec wrap reveal" id="form">
    <div class="np-grid">
      <form class="np-form" id="npForm" novalidate>
        <h2 class="np-form-h">Розкажіть, чим можемо допомогти</h2>
        <div class="np-row2">
          <label class="np-fld"
            ><span>Ваше ім'я</span><input
              type="text"
              name="name"
              autocomplete="name"
              placeholder="Введіть ваше ім'я"
            /><small class="np-err"></small></label
          >
          <label class="np-fld"
            ><span>Email</span><input
              type="email"
              name="email"
              autocomplete="email"
              placeholder="you@example.com"
            /><small class="np-err"></small></label
          >
        </div>
        <label class="np-fld"
          ><span>Телефон</span><input
            type="tel"
            name="phone"
            autocomplete="tel"
            placeholder="+38 (0__) ___-__-__"
          /><small class="np-err"></small></label
        >
        <label class="np-fld"
          ><span>Тема повідомлення</span><input
            type="text"
            name="subject"
            placeholder="Коротко опишіть тему"
          /><small class="np-err"></small></label
        >
        <label class="np-fld"
          ><span>Повідомлення</span><textarea
            rows="5"
            name="message"
            placeholder="Детально опишіть ваш запит або питання"
          ></textarea><small class="np-err"></small></label
        >
        <div
          class="np-status"
          id="npStatus"
          role="status"
          aria-live="polite"
          hidden
        >
        </div>
        <div class="np-form-foot">
          <button class="np-form-btn" type="submit"
            >Надіслати повідомлення<span
              class="fbtn-ar"
              set:html={arrow}
            /></button
          >
          <div class="np-form-note">
            <span set:html={IC.shield} />Ваші дані захищені та не передаються
            третім особам
          </div>
        </div>
      </form>

      <aside class="np-side">
        <div class="np-ways">
          <h3 class="np-side-h">Інші способи зв'язку</h3>
          {
            ways.map((w) => (
              <a
                class="np-way"
                href={w.href}
                target={w.href.startsWith("http") ? "_blank" : undefined}
                rel={w.href.startsWith("http") ? "noopener" : undefined}
              >
                <span class="np-way-ic" style={`background:${w.bg}`}>
                  {w.img ? (
                    <img src={`/img/logos/${w.img}`} alt={w.nm} />
                  ) : (
                    <span class="np-way-svg" set:html={w.raw || w.ic} />
                  )}
                </span>
                <div class="np-way-tx">
                  <>
                    <b>{w.nm}</b>
                    <span>{w.s}</span>
                  </>
                </div>
                <span class="np-way-ar" set:html={arrow} />
              </a>
            ))
          }
        </div>
        <div class="np-urgent">
          <h3 class="np-urgent-h">Онлайн-зустріч</h3>
          <p>
            Заплануйте 30-хвилинну онлайн-зустріч із нашою командою для
            демонстрації платформи або консультації.
          </p>
          <a
            class="np-urgent-btn"
            href="https://calendly.com/zapys24/30min?month=2026-07"
            target="_blank"
            rel="noopener"><span set:html={IC.clock} />Запланувати зустріч</a
          >
        </div>
      </aside>
    </div>
  </section>

  <!-- STEPS -->
  <section class="np-steps-sec reveal">
    <div class="wrap">
      <div class="kicker kx-kick">Процес</div>
      <h2 class="sh kx-ctr-h">
        Що відбувається після <span class="ac">відправки?</span>
      </h2>
      <div class="np-steps">
        <div class="np-steps-line"></div>
        {
          steps.map((s, i) => (
            <div class="np-step">
              <span class="np-step-ic" set:html={s.ic} />
              <b>{s.t}</b>
              <p>{s.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="kr-sec wrap reveal">
    <div class="np-faq-head">
      <h2 class="sh">Часті <span class="ac">питання</span></h2><a
        class="np-faq-all"
        href="/#faq"
        >Переглянути всі питання<span class="fbtn-ar" set:html={arrow} /></a
      >
    </div>
    <div class="kx-faq">
      {
        faqs.map((f, i) => (
          <details class="kc-faq-item" open={i === 0}>
            <summary>
              {f.q}
              <span class="kx-faq-chev">⌄</span>
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="reveal final-sec">
    <div class="final">
      <div class="final-in">
        <h2 class="dis">Готові почати?</h2>
        <p>Приєднуйтесь, довірте рутину Zapys24.</p>
        <div class="fcta">
          <a class="fbtn" href="#" data-signup
            >Спробувати безкоштовно<span class="fbtn-ar" set:html={arrow} /></a
          >
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script is:inline>
  (function () {
    var form = document.getElementById("npForm");
    if (!form) return;
    var btn = form.querySelector(".np-form-btn");
    var status = document.getElementById("npStatus");
    var ENDPOINT = "/api/contact";

    // Ключі payload мають збігатися з тим, що очікує бекенд landing/contact.
    var rules = [
      {
        name: "name",
        ok: function (v) {
          return v.trim().length >= 2;
        },
        msg: "Вкажіть ім'я (мінімум 2 символи)",
      },
      {
        name: "email",
        ok: function (v) {
          return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim());
        },
        msg: "Вкажіть коректний email",
      },
      {
        name: "phone",
        ok: function (v) {
          return v.replace(/\D/g, "").length >= 9;
        },
        msg: "Вкажіть коректний номер телефону",
      },
      {
        name: "subject",
        ok: function (v) {
          return v.trim().length >= 2;
        },
        msg: "Вкажіть тему повідомлення",
      },
      {
        name: "message",
        ok: function (v) {
          return v.trim().length >= 10;
        },
        msg: "Опишіть запит (мінімум 10 символів)",
      },
    ];

    function fieldEl(name) {
      return form.querySelector('[name="' + name + '"]');
    }
    function setErr(el, msg) {
      var fld = el.closest(".np-fld");
      if (!fld) return;
      fld.classList.add("has-error");
      var e = fld.querySelector(".np-err");
      if (e) e.textContent = msg;
    }
    function clearErr(el) {
      var fld = el.closest(".np-fld");
      if (!fld) return;
      fld.classList.remove("has-error");
      var e = fld.querySelector(".np-err");
      if (e) e.textContent = "";
    }
    function showStatus(type, msg) {
      status.hidden = false;
      status.className = "np-status np-status-" + type;
      status.textContent = msg;
    }

    rules.forEach(function (r) {
      var el = fieldEl(r.name);
      if (!el) return;
      el.addEventListener("input", function () {
        clearErr(el);
      });
      el.addEventListener("change", function () {
        clearErr(el);
      });
    });

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      status.hidden = true;

      var valid = true;
      var firstBad = null;
      var payload = {};
      rules.forEach(function (r) {
        var el = fieldEl(r.name);
        var v = el ? el.value : "";
        // телефон надсилаємо без форматування — лише цифри та + (як очікує бекенд)
        payload[r.name] =
          r.name === "phone" ? v.replace(/[^\d+]/g, "") : v.trim();
        if (!el || !r.ok(v)) {
          valid = false;
          if (el) {
            setErr(el, r.msg);
            if (!firstBad) firstBad = el;
          }
        }
      });
      if (!valid) {
        if (firstBad) firstBad.focus();
        return;
      }

      btn.disabled = true;
      btn.classList.add("is-loading");

      fetch(ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      })
        .then(function (res) {
          return res
            .json()
            .catch(function () {
              return {};
            })
            .then(function (data) {
              return { ok: res.ok, data: data };
            });
        })
        .then(function (r) {
          if (r.ok && r.data.success !== false) {
            showStatus(
              "ok",
              (r.data && r.data.message) ||
                "Дякуємо! Ваше повідомлення надіслано — ми зв'яжемося з вами найближчим часом.",
            );
            form.reset();
          } else {
            showStatus(
              "err",
              (r.data && r.data.message) ||
                "Не вдалося надіслати повідомлення. Спробуйте пізніше.",
            );
          }
        })
        .catch(function () {
          showStatus(
            "err",
            "Помилка мережі. Перевірте з'єднання та спробуйте ще раз.",
          );
        })
        .finally(function () {
          btn.disabled = false;
          btn.classList.remove("is-loading");
        });
    });
  })();
</script>
