---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const fmt = (n: number) => n.toLocaleString('uk-UA');
const S = (p: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;
const Sw = (p: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;

const VIC = {
  scissors: Sw('<path d="M3 7a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"/><path d="M3 17a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"/><path d="M8.6 8.6l10.4 10.4"/><path d="M8.6 15.4l10.4 -10.4"/>'),
  horse: Sw('<path d="M7 10l-.85 8.507a1.357 1.357 0 0 0 1.35 1.493h.146a2 2 0 0 0 1.857 -1.257l.994 -2.486a2 2 0 0 1 1.857 -1.257h1.292a2 2 0 0 1 1.857 1.257l.994 2.486a2 2 0 0 0 1.857 1.257h.146a1.37 1.37 0 0 0 1.364 -1.494l-.864 -9.506h-8c0 -3 -3 -5 -6 -5l-3 6l2 2l3 -2"/><path d="M22 14v-2a3 3 0 0 0 -3 -3"/>'),
  car: Sw('<path d="M5 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/><path d="M15 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/><path d="M5 17h-2v-6l2 -5h9l4 5h1a2 2 0 0 1 2 2v4h-2m-4 0h-6m-6 -6h15m-6 0v-5"/>'),
  dumbbell: Sw('<path d="M2 12h1"/><path d="M6 8h-2a1 1 0 0 0 -1 1v6a1 1 0 0 0 1 1h2"/><path d="M6 7v10a1 1 0 0 0 1 1h1a1 1 0 0 0 1 -1v-10a1 1 0 0 0 -1 -1h-1a1 1 0 0 0 -1 1"/><path d="M9 12h6"/><path d="M15 7v10a1 1 0 0 0 1 1h1a1 1 0 0 0 1 -1v-10a1 1 0 0 0 -1 -1h-1a1 1 0 0 0 -1 1"/><path d="M18 8h2a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-2"/><path d="M22 12h-1"/>'),
  cross: Sw('<path d="M6 4h-1a2 2 0 0 0 -2 2v3.5a5.5 5.5 0 0 0 11 0v-3.5a2 2 0 0 0 -2 -2h-1"/><path d="M8 15a6 6 0 1 0 12 0v-3"/><path d="M11 3v2"/><path d="M6 3v2"/><path d="M18 10a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/>'),
};
const IC = {
  calendar: S('<rect x="4" y="5" width="16" height="16" rx="2.5"/><path d="M16 3v4M8 3v4M4 11h16"/>'),
  users: S('<path d="M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M3 20v-1a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v1"/><path d="M16 5.5a3 3 0 0 1 0 5.5M21 20v-1a4 4 0 0 0-3-3.8"/>'),
  bell: S('<path d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3H4a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6"/><path d="M9 17v1a3 3 0 0 0 6 0v-1"/>'),
  wallet: S('<path d="M17 8V5a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v3m0 4v1a1 1 0 0 1-1 1H5a2 2 0 0 1-2-2V6"/><path d="M20 12v4h-4a2 2 0 0 1 0-4h4"/>'),
  chart: S('<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>'),
  bolt: S('<path d="M13 3l0 7l6 0l-8 11l0 -7l-6 0l8 -11"/>'),
  plug: S('<path d="M9 3v6M15 3v6M7 9h10a1 1 0 0 1 1 1v2a6 6 0 0 1-12 0v-2a1 1 0 0 1 1-1"/><path d="M12 18v3"/>'),
  branch: S('<circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="12" r="2.5"/><path d="M8.5 6H14a2 2 0 0 1 2 2v2M8.5 18H14a2 2 0 0 0 2-2v-2"/>'),
  shield: S('<path d="M12 3l7 3v5c0 4.5-3 7.4-7 9c-4-1.6-7-4.5-7-9V6l7-3"/><path d="M9 12l2 2l4-4"/>'),
  lock: S('<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>'),
  flag: S('<path d="M5 21V4M5 4h11l-1.5 4L16 12H5"/>'),
  card: S('<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 10h18M7 15h3"/>'),
  send: S('<path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/>'),
  head: S('<path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="2.5" y="13" width="4" height="7" rx="2"/><rect x="17.5" y="13" width="4" height="7" rx="2"/><path d="M20 19.5a3 3 0 0 1-3 2.5h-3"/>'),
  check: S('<path d="M5 12.5l4.5 4.5L19 7"/>'),
};

// ── Тарифи з бекенду ──────────────────────────────────────────────
// Валюта у відповіді відсутня — показуємо у гривнях.
const CURRENCY = '₴';
const money = (n: number) => `${fmt(n)} ${CURRENCY}`;
// Куди веде кнопка кожного тарифу (register відповідної індустрії).
// УВАГА: піддомен medical — припущення, звірте з бекендом.
const REGISTER: Record<string, string> = {
  beauty: 'https://beauty.zapys24.com/register',
  equestrian: 'https://horse.zapys24.com/register',
  medical: 'https://med.zapys24.com/register',
};

// Індустрії з реальними тарифами (порядок = порядок пілюль).
const REAL = [
  { key: 'beauty', label: 'Краса', dot: 'var(--n-beauty, #7C3AED)', ic: VIC.scissors },
  { key: 'equestrian', label: 'Кінний спорт', dot: 'var(--n-eq, #6B4A35)', ic: VIC.horse },
];
// Індустрії без тарифів — показуємо як «Скоро».
const SOON = [
  { key: 'medical', label: 'Медицина', dot: 'var(--n-med, #DB2777)', ic: VIC.cross, soon: true },
  { key: 'auto_service', label: 'Авто', dot: 'var(--n-auto, #2563EB)', ic: VIC.car, soon: true },
  { key: 'fitness', label: 'Фітнес', dot: 'var(--n-fit, #16A34A)', ic: VIC.dumbbell, soon: true },
];

let apiPlans = [];
try {
  const res = await fetch('https://api.zapys24.com/api/v1/billing/plans?industry=all');
  if (res.ok) apiPlans = await res.json();
} catch (_) {}

const byIndustry = (code: string) => apiPlans
  .filter((p: any) => p.industry === code && p.isActive)
  .sort((a: any, b: any) => (a.sortOrder - b.sortOrder) || (a.price - b.price));

// Реальні індустрії з планами (без даних — відсіюємо, напр. якщо fetch впав).
const industries = REAL
  .map((m) => ({ ...m, plans: byIndustry(m.key) }))
  .filter((g) => g.plans.length > 0);

// -1 у лімітах = без обмежень.
const smsIncl = (p: any) => (p.features.notificationPolicy || {}).smsMonthlyIncluded ?? 0;
function highlights(p: any) {
  const L = p.limits, F = p.features, out = [];
  out.push(L.maxStaffPerBusiness === -1 ? 'Без лімітів співробітників' : `До ${L.maxStaffPerBusiness} співробітників`);
  out.push(L.maxBookingsPerMonth === -1 ? 'Безлімітні записи' : `${fmt(L.maxBookingsPerMonth)} записів/міс`);
  out.push(L.maxClientsPerBusiness === -1 ? 'Без лімітів клієнтів' : `${fmt(L.maxClientsPerBusiness)} клієнтів`);
  if (F.hasSmsNotifications) out.push(`SMS-сповіщення · ${smsIncl(p)}/міс`);
  if (F.hasFinanceReports) out.push('Фінансові звіти');
  if (F.hasSalaryManagement) out.push('Зарплати команди');
  if (F.apiAccess) out.push('API та інтеграції');
  if (F.prioritySupport) out.push('Пріоритетна підтримка');
  if (F.customBranding) out.push('Власний бренд');
  return out.slice(0, 6);
}
function ctaLabel(p: any) {
  if (p.price === 0) return 'Почати безкоштовно';
  if (p.trialDays > 0) return `Спробувати ${p.trialDays} днів`;
  return 'Обрати план';
}

// Повний функціонал: групи рядків із ключами бекенду.
// type 'bool' → features[k]; 'limit' → limits[k]; 'sms' → notificationPolicy.smsMonthlyIncluded.
const FEAT_GROUPS = [
  { key: 'booking', label: 'Записи та розклад', ic: IC.calendar, rows: [
    { label: 'Онлайн-запис 24/7', type: 'bool', k: 'hasOnlineBooking' },
    { label: 'Записів на місяць', type: 'limit', k: 'maxBookingsPerMonth' },
    { label: 'Послуг', type: 'limit', k: 'maxServicesPerBusiness' },
    { label: 'Фото на послугу', type: 'limit', k: 'maxPhotosPerService' },
    { label: 'Знижки та акції', type: 'bool', k: 'hasDiscounts' },
  ]},
  { key: 'crm', label: 'Клієнти', ic: IC.users, rows: [
    { label: 'Клієнтів у базі', type: 'limit', k: 'maxClientsPerBusiness' },
    { label: 'Абонементи клієнтів', type: 'bool', k: 'hasClientSubscriptions' },
    { label: 'Способи оплати', type: 'bool', k: 'hasPaymentMethods' },
  ]},
  { key: 'team', label: 'Команда та філії', ic: IC.branch, rows: [
    { label: 'Бізнесів (філій)', type: 'limit', k: 'maxBusinesses' },
    { label: 'Співробітників', type: 'limit', k: 'maxStaffPerBusiness' },
    { label: 'Рейтинг персоналу', type: 'bool', k: 'hasStaffRanking' },
    { label: 'Вакансії', type: 'bool', k: 'hasJobVacancies' },
    { label: 'Адмін-панель', type: 'bool', k: 'hasAdmin' },
  ]},
  { key: 'reminders', label: 'Сповіщення', ic: IC.bell, rows: [
    { label: 'SMS-сповіщення', type: 'bool', k: 'hasSmsNotifications' },
    { label: 'SMS у місяць', type: 'sms' },
    { label: 'Email-сповіщення', type: 'bool', k: 'hasEmailNotifications' },
    { label: 'Пуш-сповіщення', type: 'bool', k: 'hasNotifications' },
  ]},
  { key: 'finance', label: 'Фінанси', ic: IC.wallet, rows: [
    { label: 'Фінансові звіти', type: 'bool', k: 'hasFinanceReports' },
    { label: 'Облік витрат', type: 'bool', k: 'hasExpenseTracking' },
    { label: 'Зарплати команди', type: 'bool', k: 'hasSalaryManagement' },
  ]},
  { key: 'analytics', label: 'Аналітика', ic: IC.chart, rows: [
    { label: 'Статистика', type: 'bool', k: 'hasStatistics' },
    { label: 'Експорт даних', type: 'bool', k: 'hasExport' },
  ]},
  { key: 'api', label: 'Інтеграції', ic: IC.plug, rows: [
    { label: 'API-доступ', type: 'bool', k: 'apiAccess' },
    { label: 'Власний бренд', type: 'bool', k: 'customBranding' },
    { label: 'Пріоритетна підтримка', type: 'bool', k: 'prioritySupport' },
  ]},
];
const ckCell = `<span class="tp-ck">${IC.check}</span>`;
const dashCell = '<span class="tp-dash">—</span>';
function cellFor(p: any, row: any) {
  if (row.type === 'bool') return p.features[row.k] ? ckCell : dashCell;
  const v = row.type === 'sms' ? smsIncl(p) : p.limits[row.k];
  if (v === -1) return '<span class="tp-num">∞</span>';
  if (v === 0 || v == null) return dashCell;
  return `<span class="tp-num">${fmt(v)}</span>`;
}

const TRUST = [
  { ic: IC.shield, t: 'Без комісій з записів' },
  { ic: IC.calendar, t: '14 днів безкоштовно' },
  { ic: IC.lock, t: 'Без прихованих платежів' },
  { ic: IC.flag, t: 'Підтримка українською' },
];

const FAQ = [
  { q: 'Чи є комісія з моїх записів?', a: 'Ні. Ви платите фіксовану місячну ціну, а всі гроші від клієнтів — ваші. Жодних відсотків.' },
  { q: 'Чи можна змінити або скасувати тариф?', a: 'Так, будь-коли. Перехід між планами миттєвий, без штрафів. База клієнтів завжди лишається вашою.' },
  { q: 'Що після 14 днів безкоштовно?', a: 'Просто оберете план, коли будете готові. Картку наперед не просимо — тестуйте спокійно.' },
  { q: 'Скільки коштують SMS-нагадування?', a: 'SMS входять у платні плани пакетами; понад ліміт — за собівартістю оператора, без націнки.' },
];
---

<Layout
  title="Тарифи Zapys24 — плани та ціни онлайн-запису"
  description="Тарифи Zapys24 для салонів краси та кінного спорту. Прозорі плани, безкоштовний період, без прихованих платежів."
>
  <Nav />
  <main class="tp">

    <!-- HERO -->
    <section class="tp-hero wrap">
      <div class="tp-hero-l">
        <div class="kicker" style="color:var(--violet)">Тарифи</div>
        <h1 class="dis tp-h1">Оберіть свій<br>план</h1>
        <p class="tp-sub">Фіксована ціна, жодних комісій із записів. Виберіть тариф, який підходить саме вам.</p>
        <div class="tp-pills" id="tpPills">
          {[...industries, ...SOON].map((v: any, i: number) => (
            <button class={`tp-pill${i === 0 ? ' on' : ''}${v.soon ? ' soon' : ''}`} data-k={v.key} type="button">
              <span class="tp-pill-ic" style={`background:${v.dot}`} set:html={v.ic}></span>{v.label}
              {v.soon && <span class="tp-pill-soon">Скоро</span>}
            </button>
          ))}
        </div>
      </div>
      <div class="tp-hero-r">
        <img class="tp-cal" src="/img/kalendar.webp" alt="Календар записів Zapys24" width="1536" height="1024" loading="lazy" decoding="async" />
        <span class="tp-float tp-float-1"><i class="tp-fdot"></i><div><b>Новий запис</b><em>Олена, 14:00</em></div></span>
        <span class="tp-float tp-float-2"><span class="tp-fic v" set:html={IC.calendar}></span><div><b>Запис перенесено</b><em>на 16:00</em></div></span>
        <span class="tp-float tp-float-3"><span class="tp-fic b" set:html={IC.send}></span><div><b>SMS відправлено</b><em>Клієнту</em></div></span>
      </div>
    </section>

    <!-- PRICING CARDS -->
    <section class="wrap tp-plans-sec">
      {industries.map((g, i) => (
        <div
          class={`tp-plans${i === 0 ? ' on' : ''}${g.plans.length >= 4 ? ' tp-plans-dense' : ''}`}
          data-ind={g.key}
          style={`--cols:${g.plans.length}`}
        >
          {g.plans.map((pl: any) => (
            <div class={`tp-card${pl.isPopular ? ' pop' : ''}`}>
              {pl.isPopular && <span class="tp-pop-badge">Популярний</span>}
              <b class="tp-card-name">{pl.name}</b>
              <p class="tp-card-desc">{pl.description}</p>
              <div class="tp-card-price"><span class="tp-amt">{money(pl.price)}</span><small>/міс</small></div>
              {pl.yearlyPrice ? <div class="tp-card-year">або {money(pl.yearlyPrice)}/рік</div> : null}
              {pl.price > 0 && pl.trialDays > 0 ? <div class="tp-card-trial">{pl.trialDays} днів безкоштовно</div> : null}
              <ul class="tp-feat">{highlights(pl).map(x => (<li><i class="tp-feat-ck" set:html={IC.check}></i>{x}</li>))}</ul>
              <a class={`tp-card-btn${pl.isPopular ? ' pop' : ''}`} href={REGISTER[g.key] || '#'} target="_blank" rel="noopener">{ctaLabel(pl)}</a>
            </div>
          ))}
        </div>
      ))}
      {SOON.map(g => (
        <div class="tp-plans tp-plans-soon" data-ind={g.key}>
          <div class="tp-soon-card">
            <span class="tp-soon-ic" style={`background:${g.dot}`} set:html={g.ic}></span>
            <b>Тарифи для сфери «{g.label}» — скоро</b>
            <p>Ми готуємо окремі плани під цю індустрію. Залиште контакт — і ми повідомимо про запуск.</p>
            <a class="tp-card-btn pop" href="/write#form">Повідомити мене</a>
          </div>
        </div>
      ))}
    </section>

    <!-- TRUST BAR -->
    <section class="wrap tp-trust">
      {TRUST.map(t => (<div class="tp-trust-i"><span class="tp-trust-ic" set:html={t.ic}></span>{t.t}</div>))}
    </section>

    {/* ROI CALCULATOR — тимчасово вимкнено (розкоментувати за потреби)
    <section class="wrap tp-calc-sec">
      <div class="tp-calc">
        <div class="tp-calc-tx">
          <h2>Порахуйте свою<br>економію</h2>
          <p>Zapys24 допомагає автоматизувати рутинні задачі та збільшити прибуток.</p>
        </div>
        <div class="tp-calc-field">
          <label>Кількість майстрів</label>
          <div class="tp-stepper"><button class="tp-step" data-t="masters" data-d="-1" type="button">−</button><b id="tpMasters">5</b><button class="tp-step" data-t="masters" data-d="1" type="button">+</button></div>
        </div>
        <span class="tp-calc-x">×</span>
        <div class="tp-calc-field">
          <label>Середній чек (€)</label>
          <div class="tp-stepper"><button class="tp-step" data-t="check" data-d="-1" type="button">−</button><b id="tpCheck">800</b><button class="tp-step" data-t="check" data-d="1" type="button">+</button></div>
        </div>
        <span class="tp-calc-eq">=</span>
        <div class="tp-calc-out">
          <span class="tp-calc-out-l">Ваша економія щомісяця</span>
          <b id="tpMonthly">+16 000 €</b>
          <em>На рік: <span id="tpYearly">+192 000 €</span></em>
        </div>
      </div>
    </section>
    */}

    <!-- FULL FEATURE COMPARISON -->
    <section class="wrap tp-fn-sec" id="tpFnSec">
      <h2 class="sh tp-fn-h">Повний функціонал</h2>
      <div class="tp-fn">
        <aside class="tp-cats" id="tpCats">
          {FEAT_GROUPS.map((c, i) => (
            <button class={`tp-cat${i === 0 ? ' on' : ''}`} data-c={c.key} type="button"><span class="tp-cat-ic" set:html={c.ic}></span>{c.label}</button>
          ))}
        </aside>
        <div class="tp-fn-tables">
          {industries.map((g, gi) => (
            <div class={`tp-fn-table tp-fn-block${gi === 0 ? ' on' : ''}`} data-ind={g.key}>
              <table>
                <thead>
                  <tr>
                    <th class="tp-th-f">Функції</th>
                    {g.plans.map(p => (<th class={`tp-th${p.isPopular ? ' tp-th-pop' : ''}`}>{p.name}</th>))}
                  </tr>
                </thead>
                {FEAT_GROUPS.map((c, ci) => (
                  <tbody class={`tp-catbody${ci === 0 ? ' on' : ''}`} data-c={c.key}>
                    {c.rows.map(r => (
                      <tr>
                        <td class="tp-td-f"><b>{r.label}</b></td>
                        {g.plans.map(p => (<td class={`tp-td${p.isPopular ? ' tp-td-pop' : ''}`} set:html={cellFor(p, r)}></td>))}
                      </tr>
                    ))}
                  </tbody>
                ))}
              </table>
            </div>
          ))}
          <button class="tp-showall" id="tpShowAll" type="button">Показати всі категорії<span class="tp-showall-ch">▾</span></button>
        </div>
      </div>
    </section>

    <!-- FAQ + CUSTOM -->
    <section class="wrap tp-bottom">
      <div class="tp-faq">
        <h2 class="sh tp-faq-h">Часті запитання</h2>
        <div class="tp-faq-list">
          {FAQ.map(item => (
            <details class="tp-faq-item">
              <summary>{item.q}<span class="tp-faq-ic">+</span></summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
      <div class="tp-custom">
        <span class="tp-custom-ic" set:html={IC.head}></span>
        <h3>Потрібен індивідуальний план?</h3>
        <p>Мережа, особливі інтеграції чи великий обсяг — підберемо умови під вас.</p>
        <a class="tp-custom-btn" href="/write#form">Поговорити з нами</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const pills = Array.from(document.querySelectorAll<HTMLElement>('#tpPills .tp-pill'));
  const planSets = Array.from(document.querySelectorAll<HTMLElement>('.tp-plans'));
  const fnBlocks = Array.from(document.querySelectorAll<HTMLElement>('.tp-fn-block'));
  const fnSec = document.getElementById('tpFnSec');

  // перемикання індустрії: картки + таблиця + приховування порівняння для «Скоро»
  pills.forEach((p) => p.addEventListener('click', () => {
    const k = p.dataset.k;
    pills.forEach((x) => x.classList.toggle('on', x === p));
    planSets.forEach((s) => s.classList.toggle('on', s.dataset.ind === k));
    let hasTable = false;
    fnBlocks.forEach((b) => {
      const match = b.dataset.ind === k;
      b.classList.toggle('on', match);
      if (match) hasTable = true;
    });
    if (fnSec) fnSec.style.display = hasTable ? '' : 'none';
  }));

  // перемикання категорій
  const cats = Array.from(document.querySelectorAll<HTMLElement>('#tpCats .tp-cat'));
  const bodies = Array.from(document.querySelectorAll<HTMLElement>('.tp-catbody'));
  const showAll = document.getElementById('tpShowAll');
  let allOpen = false;
  const setLabel = (txt: string) => {
    if (showAll && showAll.firstChild) showAll.firstChild.textContent = txt;
  };
  const activeCat = () => {
    const on = cats.find((c) => c.classList.contains('on'));
    return on ? on.dataset.c : undefined;
  };
  cats.forEach((c) => c.addEventListener('click', () => {
    allOpen = false;
    if (showAll) showAll.classList.remove('on');
    setLabel('Показати всі категорії');
    cats.forEach((x) => x.classList.toggle('on', x === c));
    bodies.forEach((b) => b.classList.toggle('on', b.dataset.c === c.dataset.c));
  }));
  if (showAll) showAll.addEventListener('click', () => {
    allOpen = !allOpen;
    showAll.classList.toggle('on', allOpen);
    setLabel(allOpen ? 'Згорнути категорії' : 'Показати всі категорії');
    const key = activeCat();
    bodies.forEach((b) => b.classList.toggle('on', allOpen || b.dataset.c === key));
  });
</script>
