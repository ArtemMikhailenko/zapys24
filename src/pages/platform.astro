  <script>
    (() => {
      const menu = document.querySelectorAll(".ws-mi");
      const panels = document.querySelectorAll(".ws-p");
      const seg = document.getElementById("wsSeg");
      const rail = document.querySelectorAll(".ws-rn");
      const urls = [
        "app.zapys24.com/записи",
        "beauty.zapys24.com/онлайн-запис",
        "app.zapys24.com/фінанси",
        "app.zapys24.com/клієнти",
        "app.zapys24.com/дашборд",
        "app.zapys24.com/команда",
      ];
      const navFor = ["book", null, "finance", "clients", "dash", "team"];
      let cur = 0,
        timer = null,
        stopped = false;
      function go(i) {
        cur = (i + menu.length) % menu.length;
        menu.forEach((m, j) => {
          const on = j === cur;
          m.classList.toggle("on", on);
          m.setAttribute("aria-selected", on ? "true" : "false");
        });
        panels.forEach((p) => p.classList.toggle("on", +p.dataset.p === cur));
        const nav = navFor[cur];
        rail.forEach((r) =>
          r.classList.toggle(
            "on",
            !!nav && r.classList.contains("ws-rn-" + nav),
          ),
        );
        if (seg) seg.textContent = urls[cur];
      }
      function tick() {
        if (!stopped) go(cur + 1);
      }
      function restart() {
        if (timer) clearInterval(timer);
        timer = setInterval(tick, 3600);
      }
      menu.forEach((m, j) => {
        m.addEventListener("click", () => {
          stopped = true;
          if (timer) clearInterval(timer);
          go(j);
        });
        m.addEventListener("mouseenter", () => {
          stopped = true;
        });
        m.addEventListener("mouseleave", () => {
          stopped = false;
        });
      });
      const stage = document.querySelector(".ws-stage");
      if (stage && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (es) =>
            es.forEach((e) => {
              if (e.isIntersecting) restart();
              else if (timer) clearInterval(timer);
            }),
          { threshold: 0.25 },
        );
        io.observe(stage);
      } else {
        restart();
      }
    })();
  </script>

