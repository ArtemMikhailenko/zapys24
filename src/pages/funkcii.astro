---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>';
const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>';
const S = (p) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;
const IC = {
  cal:   S('<path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2l0 -12"/><path d="M16 3l0 4"/><path d="M8 3l0 4"/><path d="M4 11l16 0"/>'),
  heart: S('<path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.566"/>'),
  team:  S('<path d="M10 13a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"/><path d="M8 21v-1a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v1"/><path d="M15 5a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"/><path d="M17 10h2a2 2 0 0 1 2 2v1"/><path d="M5 5a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"/><path d="M3 13v-1a2 2 0 0 1 2 -2h2"/>'),
  box:   S('<path d="M12 3l8 4.5v9l-8 4.5l-8 -4.5v-9l8 -4.5"/><path d="M12 12l8 -4.5"/><path d="M12 12l0 9"/><path d="M12 12l-8 -4.5"/>'),
  msg:   S('<path d="M8 9h8"/><path d="M8 13h6"/><path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12"/>'),
  star:  S('<path d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z"/>'),
  cal2:  S('<path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2l0 -12"/><path d="M16 3l0 4"/><path d="M8 3l0 4"/><path d="M4 11l16 0"/>'),
};
const bottle = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 5h4"/><path d="M10 3h4v2a4 4 0 0 1 -.5 2l-.5 1v2l2.5 6a2 2 0 0 1 -1.9 2.9h-3.2a2 2 0 0 1 -1.9 -2.9l2.5 -6v-2l-.5 -1a4 4 0 0 1 -.5 -2z"/></svg>';

const feats = [
  { badge:'Для запису', ic:IC.cal, h:'Простий та зручний онлайн-запис', d:'Клієнти записуються 24/7, обирають майстра, послугу та зручний час. Менше дзвінків — більше записів.', b:['Онлайн-запис 24/7','Гнучкі налаштування послуг','Автоматичне підтвердження'] },
  { badge:'Для клієнтів', ic:IC.heart, h:'Управління клієнтами та історією візитів', d:'Зберігайте всю інформацію про клієнтів: контакти, візити, вподобання, нотатки та історію послуг.', b:['Профілі клієнтів','Історія візитів та послуг','Нагадування про записи'] },
  { badge:'Для команди', ic:IC.team, h:'Ефективне управління командою', d:'Розподіляйте ролі, контролюйте завантаженість майстрів та відстежуйте результати роботи команди.', b:['Ролі та права доступу','Графік роботи майстрів','Статистика та KPI'] },
  { badge:'Для продажів', ic:IC.box, h:'Торгівля та склад під контролем', d:'Ведіть облік товарів, матеріалів та залишків на складі. Контролюйте витрати та прибуток у реальному часі.', b:['Складський облік','Продаж товарів клієнтам','Автоматичне списання'] },
  { badge:'Для спілкування', ic:IC.msg, h:'Нагадування, SMS та email розсилки', d:'Автоматичні нагадування та розсилки допомагають повертати клієнтів і збільшити повторні візити.', b:['SMS та email нагадування','Персоналізовані розсилки','Шаблони повідомлень'] },
  { badge:'Для якості сервісу', ic:IC.star, h:'Анкети та зворотний зв’язок від клієнтів', d:'Збирайте відгуки, оцінюйте якість послуг та покращуйте сервіс разом із клієнтами.', b:['Анкети після візиту','Оцінки та відгуки','Аналіз задоволеності'] },
];
---

<Layout title="Функції — Zapys24">
  <Nav />

  <section class="kr-sec wrap reveal fn-top">
    <div class="fn-head">
      <div class="kicker" style="color:var(--violet)">Можливості</div>
      <h1 class="dis fn-h1">Одна платформа,<br>все, <span class="ac">що вам потрібно</span></h1>
      <p class="fn-sub">Zapys24 об'єднує всі інструменти для управління салоном краси, спа або клінікою в одному зручному сервісі.</p>
    </div>

    <div class="fn-rows">
      {feats.map((f, i) => (
        <div class="fn-row reveal">
          <div class="fn-row-tx">
            <div class="fn-badge"><span class="fn-badge-ic" set:html={f.ic}></span>{f.badge}</div>
            <h2 class="fn-row-h">{f.h}</h2>
            <p class="fn-row-d">{f.d}</p>
            <ul class="fn-row-list">
              {f.b.map(x => (<li><span class="fn-ck" set:html={check}></span>{x}</li>))}
            </ul>
            <a class="fn-more" href="#">Дізнатися більше<span class="fbtn-ar" set:html={arrow}></span></a>
          </div>
          <div class="fn-row-mkwrap">
            {i===0 && (
              <div class="fn-mk fnc">
                <div class="fnc-top"><div class="fnc-cli"><span class="fnc-av" style="background-image:url(/img/quote.webp)"></span><div class="fnc-clt"><b>Ноена К.</b><i>Стрижка та догляд</i></div></div><span class="fnc-chip">Сьогодні <span class="fnc-dot"></span></span></div>
                <div class="fnc-grid">
                  <div class="fnc-times"><span>09:00</span><span>10:00</span><span>11:00</span><span>12:00</span><span>13:00</span></div>
                  <div class="fnc-track">
                    <i class="fnc-line" style="top:20%"></i><i class="fnc-line" style="top:40%"></i><i class="fnc-line" style="top:60%"></i><i class="fnc-line" style="top:80%"></i>
                    <span class="fnc-ev v" style="top:4%;left:4%;height:16%">Манікюр<small>Олена К.</small></span>
                    <span class="fnc-ev g" style="top:34%;left:34%;height:20%">Фарбування<small>Ірина П.</small></span>
                    <span class="fnc-ev o" style="top:66%;left:60%;height:22%">Догляд<small>Наталія П.</small></span>
                  </div>
                </div>
                <div class="fnc-foot"><span class="on">День</span><span>Тиждень</span><span>Місяць</span></div>
              </div>
            )}
            {i===1 && (
              <div class="fn-mk fncl">
                <div class="fncl-head"><span class="fncl-av" style="background-image:url(/img/model.webp)"></span><div class="fncl-ht"><b>Олена К.</b><i>+380 97 123 45 67</i></div></div>
                <div class="fncl-tabs"><span class="on">Інформація</span><span>Історія</span><span>Нотатки</span></div>
                <div class="fncl-rows">
                  <div class="fncl-r"><span>Останній візит</span><b>24 квітня, 15:30</b></div>
                  <div class="fncl-r"><span>Послуга</span><b>Стрижка та догляд</b></div>
                  <div class="fncl-r"><span>Майстер</span><b>Марія</b></div>
                </div>
                <div class="fncl-tl">Вподобання</div>
                <div class="fncl-tags"><span>Не турбувати</span><span>Любить чай</span></div>
                <a class="fncl-add" href="#">+ Додати нотатку</a>
              </div>
            )}
            {i===2 && (
              <div class="fn-mk fnt">
                <div class="fnt-top"><div class="fnt-tt"><b>Команда</b><i>7 квітня</i></div><span class="fnt-sel">За місяць ▾</span></div>
                <div class="fnt-rev">₴84 200<em>+14%</em></div>
                <div class="fnt-bars"><i style="height:44%"></i><i style="height:60%"></i><i style="height:50%"></i><i style="height:78%"></i><i style="height:64%"></i><i style="height:94%"></i><i style="height:72%"></i></div>
                <div class="fnt-list">
                  <div class="fnt-r"><span class="fnt-av" style="background-image:url(/img/faq2.webp)"></span><div class="fnt-nm"><b>Марія Іванова</b><i>Перукар</i></div><span class="fnt-rv">₴28 400</span><em>+20%</em></div>
                  <div class="fnt-r"><span class="fnt-av" style="background-image:url(/img/quote.webp)"></span><div class="fnt-nm"><b>Олена Коваль</b><i>Косметолог</i></div><span class="fnt-rv">₴22 150</span><em>+12%</em></div>
                  <div class="fnt-r"><span class="fnt-av" style="background-image:url(/img/faq3.webp)"></span><div class="fnt-nm"><b>Ірина Турченко</b><i>Майстер</i></div><span class="fnt-rv">₴16 600</span><em>+8%</em></div>
                </div>
              </div>
            )}
            {i===3 && (
              <div class="fn-mk fnw">
                <div class="fnw-top"><b>Склад</b><span>Залишки товарів</span></div>
                <div class="fnw-row"><span class="fnw-ic" set:html={bottle}></span><div class="fnw-nm"><b>Маска для волосся</b><i>200 мл</i></div><span class="fnw-qty">8 шт.</span></div>
                <div class="fnw-row"><span class="fnw-ic" set:html={bottle}></span><div class="fnw-nm"><b>Крем для обличчя</b><i>50 мл</i></div><span class="fnw-qty">10 шт.</span></div>
                <div class="fnw-row"><span class="fnw-ic" set:html={bottle}></span><div class="fnw-nm"><b>Шампунь відновлювальний</b><i>500 мл</i></div><span class="fnw-qty">15 шт.</span></div>
              </div>
            )}
            {i===4 && (
              <div class="fn-mk fnp">
                <div class="fnp-scr">
                  <div class="fnp-date">Вівторок, 23 квітня</div>
                  <div class="fnp-time">9:41</div>
                  <div class="fnp-notes">
                    <div class="fnp-note"><span class="fnp-z">z</span><div class="fnp-nt"><b>Zapys24</b><span>Нагадування про запис завтра о 15:30</span></div></div>
                    <div class="fnp-note"><span class="fnp-z">z</span><div class="fnp-nt"><b>Zapys24</b><span>Дякуємо за візит! Оцініть якість послуги 💜</span></div></div>
                    <div class="fnp-note"><span class="fnp-z">z</span><div class="fnp-nt"><b>Zapys24</b><span>Спеціальна пропозиція: −20% на догляд</span></div></div>
                  </div>
                </div>
              </div>
            )}
            {i===5 && (
              <div class="fn-mk fnf">
                <b class="fnf-h">Оцініть ваш візит</b>
                <p class="fnf-q0">Як ви оцінюєте якість послуги?</p>
                <div class="fnf-stars"><span class="on" set:html={IC.star}></span><span class="on" set:html={IC.star}></span><span class="on" set:html={IC.star}></span><span class="on" set:html={IC.star}></span><span set:html={IC.star}></span></div>
                <p class="fnf-q">Що вам сподобалось?</p>
                <div class="fnf-a">Все було чудово!</div>
                <p class="fnf-q">Що можна покращити?</p>
                <div class="fnf-a">Більше масажних крісел 😊</div>
                <button class="fnf-btn">Надіслати</button>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="kr-sec wrap reveal">
    <div class="kc-cta">
      <div class="kc-cta-tx">
        <h2 class="dis">Готові вивести свій<br><span class="ac">б'юті-бізнес на новий</span> рівень?</h2>
        <p>Приєднуйтесь до 1 200+ салонів та майстрів, які вже працюють ефективніше з Zapys24.</p>
        <a class="fbtn kc-cta-btn" href="#">Спробувати безкоштовно<span class="fbtn-ar" set:html={arrow}></span></a>
        <div class="kc-cta-note"><span>✦ 14 днів безкоштовно</span><span>✦ Без картки</span></div>
      </div>
      <div class="kc-cta-media">
        <span class="kc-cta-fig" style="background-image:url(/img/ad-client.webp)"></span>
        <div class="kc-card kc-cc1">
          <div class="kc-card-top"><span class="kc-card-ic" set:html={IC.cal2}></span><b>Новий запис</b></div>
          <div class="kc-card-cli"><span class="kc-card-av" style="background-image:url(/img/model.webp)"></span><div><b>Олена К.</b><i>Сьогодні, 15:30</i></div></div>
        </div>
        <div class="kc-card kc-cc2">
          <div class="kc-card-top"><span class="kc-card-ic" set:html={IC.msg}></span><b>Нагадування</b></div>
          <p class="kc-card-rem"><b>Фарбування волосся</b><br>Завтра о 10:00</p>
        </div>
        <div class="kc-card kc-cc3">
          <div class="kc-card-rtop"><span>Виручка за місяць</span><em>+14%</em></div>
          <b class="kc-card-rev">₴84 200</b>
          <div class="kc-card-bars"><i style="height:38%"></i><i style="height:56%"></i><i style="height:44%"></i><i style="height:72%"></i><i style="height:60%"></i><i style="height:90%"></i></div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
