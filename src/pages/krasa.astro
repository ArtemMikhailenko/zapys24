<Layout
  title="Zapys24 для б'юті-бізнесу — онлайн-запис, CRM та аналітика для салонів"
>
  <Nav variant="dark" />

  <!-- HERO -->
  <section class="pfh kr-hero reveal">
    <div class="pfh-photo" style="background-image:url(/img/byuti-hero.webp)">
    </div>
    <div class="wrap pfh-grid">
      <div class="pfh-tx">
        <div class="kicker pfh-k">Для б'юті-бізнесу та клієнтів</div>
        <h1 class="dis pfh-h1">
          Все для <span class="ac">б'юті-бізнесу</span><br />в одному місці
        </h1>
        <p class="pfh-lead">
          Онлайн-запис, клієнти, команда, аналітика та фінанси — Zapys24
          допомагає керувати салоном легко та заробляти більше.
        </p>
        <div class="pfh-cta">
          <a class="fbtn" href="https://beauty.zapys24.com/register"
            >Спробувати безкоштовно<span class="fbtn-ar" set:html={arrow} /></a
          >
          <a
            class="kr-demo"
            href="https://demo.zapys24.com"
            target="_blank"
            rel="noopener"
            ><span class="kr-demo-ic" set:html={play} />Дивитись демо</a
          >
        </div>
        <div class="pfh-badges">
          <span
            class="pfh-store pfh-store-off"
            aria-disabled="true"
            aria-label="App Store — скоро"
            ><span class="pfh-store-ic"></span><span
              ><i>Скоро в</i><b>App Store</b></span
            ></span
          >
          <span
            class="pfh-store pfh-store-off"
            aria-disabled="true"
            aria-label="Google Play — скоро"
            ><span class="pfh-store-ic gp"></span><span
              ><i>Скоро в</i><b>Google Play</b></span
            ></span
          >
        </div>
      </div>
      <div class="pfh-media">
        <div class="pfh-card pfh-book">
          <div class="pfh-book-top">
            <span class="pfh-bell" set:html={IC.cal} /><b>Новий запис</b>
          </div>
          <div class="pfh-book-cli">
            <span class="pfh-cav" style="background-image:url(/img/model.webp)"
            ></span><div class="pfh-book-ct">
              <b>Олена К.</b><i>Сьогодні, 15:30</i>
            </div>
          </div>
          <button class="pfh-book-btn">Підтвердити</button>
        </div>
        <div class="pfh-card pfh-rev">
