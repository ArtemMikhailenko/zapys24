<script is:inline>
  (function () {
    var wrap = document.getElementById("krNiche");
    if (!wrap) return;
    var panels = wrap.querySelectorAll(".kr-niche-p");
    function act(i) {
      panels.forEach(function (p) {
        p.classList.toggle("on", +p.dataset.i === i);
      });
    }
    panels.forEach(function (p) {
      var i = +p.dataset.i;
      p.addEventListener("mouseenter", function () {
        act(i);
      });
      p.addEventListener("click", function () {
        act(i);
      });
    });
  })();
</script>
