const spark = (arr: number[]) => {
  const w = 58,
    h = 20,
    mx = Math.max(...arr),
    mn = Math.min(...arr),
    rng = mx - mn || 1;
  return arr
    .map((v, i) => {
      const x = (i / (arr.length - 1)) * w;
      const y = h - 2 - ((v - mn) / rng) * (h - 4);
      return `${i ? "L" : "M"}${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(" ");
};
