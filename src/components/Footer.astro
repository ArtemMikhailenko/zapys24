---
import Logo from "./Logo.astro";
import { CONTACTS, EMAIL, PHONE_DISPLAY } from "../data/contacts";
---

<footer class="footer">
  <div class="wrap footin">
    <div>
      <a class="flogo" href="/" aria-label="Zapys24"><Logo /></a>
      <div class="ftag">
        CRM і онлайн-запис для сервісного бізнесу. Більше записів, менше хаосу.
      </div>
      <div class="fbadges">
        <a
          class="fbadge"
          href="https://apps.apple.com/ua/app/zapys24-%D0%B7%D0%B0%D0%BF%D0%B8%D1%81%D0%B8-%D0%BE%D0%BD%D0%BB%D0%B0%D0%B9%D0%BD/id6764380820?l=ru"
          target="_blank"
          rel="noopener">▸ App Store</a
        ><a class="fbadge" href="#">▸ Google Play</a>
      </div>
      <div class="fcontacts">
        <a href={CONTACTS.phone}>{PHONE_DISPLAY}</a><a href={CONTACTS.email}
          >{EMAIL}</a
        >
      </div>
      <div class="fsocial">
        <a
          href={CONTACTS.telegram}
          target="_blank"
          rel="noopener"
          aria-label="Telegram"
          ><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path
              d="M21.9 4.3 18.7 19.4c-.24 1.06-.87 1.32-1.76.82l-4.86-3.58-2.35 2.26c-.26.26-.48.48-.98.48l.35-4.96 9.03-8.16c.39-.35-.09-.55-.6-.2L7.1 13.1l-4.8-1.5c-1.04-.33-1.06-1.04.22-1.54L20.6 3.03c.87-.32 1.63.2 1.3 1.27z"
            ></path></svg
          ></a
        >
        <a
          href={CONTACTS.instagram}
          target="_blank"
          rel="noopener"
          aria-label="Instagram"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
            ><rect x="4" y="4" width="16" height="16" rx="4.5"></rect><circle
              cx="12"
              cy="12"
              r="3.2"></circle><circle
              cx="16.6"
              cy="7.4"
              r="1.1"
              fill="currentColor"
              stroke="none"></circle></svg
          ></a
        >
        <a
          href={CONTACTS.facebook}
          target="_blank"
          rel="noopener"
          aria-label="Facebook"
          ><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path
              d="M13 22v-8h3l1-4h-4V8c0-1.1.3-2 2-2h2V2.2C18.6 2.1 17.4 2 16 2c-3 0-5 1.8-5 5.2V10H8v4h3v8h2z"
            ></path></svg
          ></a
        >
        <a href={CONTACTS.viber} aria-label="Viber"
          ><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path
              d="M12 1.5c-3.1 0-5.6.4-7.3 2C3.4 4.7 2.7 6.5 2.6 8.7c-.1 2.2 0 6.3 3.8 7.4v3.2c0 .6.7.9 1.1.5l2-2.2c.8.1 1.6.1 2.5.1 3.1 0 5.6-.4 7.3-2 1.3-1.2 2-3 2.1-5.2.1-2.2-.1-4.2-1.4-5.7C18.3 2.5 15.7 1.5 12 1.5zm.1 2.1c3 0 5 .8 6.2 2.1 1 1.1 1.2 2.7 1.1 4.5-.1 1.8-.6 3.1-1.5 3.9-1.2 1.1-3.2 1.5-6 1.5-.9 0-1.8-.1-2.6-.2l-1.7 1.8v-2.5c-3.1-.6-3.4-3.5-3.3-5.3.1-1.8.6-3.1 1.5-3.9 1.2-1.1 3.2-1.9 6.3-1.9zm-2.3 2.9c-.3 0-.6.1-.8.3l-.6.6c-.4.4-.5 1-.2 1.5.7 1.4 1.9 2.6 3.3 3.3.5.3 1.1.2 1.5-.2l.6-.6c.3-.3.3-.9-.1-1.2l-.9-.6c-.3-.2-.7-.2-1 .1l-.3.3c-.7-.4-1.3-1-1.7-1.7l.3-.3c.3-.3.3-.7.1-1l-.6-.9c-.1-.2-.4-.3-.6-.3zm3.4-.4v1c1.2.2 2.1 1.1 2.3 2.3h1c-.2-1.7-1.6-3.1-3.3-3.3zm0 1.8v1c.4.1.7.4.8.8h1c-.2-.9-.9-1.6-1.8-1.8z"
            ></path></svg
          ></a
        >
      </div>
    </div>
    <div class="fcol">
      <h4>Продукт</h4><a href="/platforma">Можливості</a>{
        /* <a href="/funkcii">Функції</a> */
      }<a href="/#hsec">Галузі</a><a href="/pricing">Тарифи</a><a
        href="https://developers.zapys24.com/"
        target="_blank"
        rel="noopener">API для розробників</a
      ><a href="/#faq">FAQ</a>
    </div>
    <div class="fcol">
      <h4>Галузі</h4><a href="/krasa">Краса</a><a href="/koni">Кінний спорт</a
      ><a href="#">Автосервіс<span class="fsoon">скоро</span></a><a href="#"
        >Фітнес<span class="fsoon">скоро</span></a
      ><a href="#">Медицина<span class="fsoon">скоро</span></a>
    </div>
    <div class="fcol">
      <h4>Компанія</h4><a href="/">Головна</a><a href="/pro-nas">Про нас</a><a
        href="#">Блог</a
      ><a href="/kontakty">Контакти</a>
    </div>
    <div class="fcol">
      <h4>Правова інформація</h4><a href="/pryvatnist"
        >Політика конфіденційності</a
      ><a href="/umovy">Умови використання</a><a href="/cookies">Cookies</a>
    </div>
  </div>
  <div class="wrap footbot">
    <span>© 2026 Zapys24 · підтримка українською</span><span
      ><a href="/pryvatnist">Політика конфіденційності</a> · <a href="/umovy"
        >Умови використання</a
      ></span>
  </div>
</footer>
