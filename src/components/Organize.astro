---
const S = (p, w = 2) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${w}" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;
const ic = {
  phone: S(
    '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>',
  ),
  check: S('<path d="M5 12.5l4.5 4.5L19 7"/>', 2.6),
  bell: S(
    '<path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 01-3.4 0"/>',
  ),
  cal: S(
    '<rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/>',
  ),
  alert: S(
    '<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5"/><circle cx="12" cy="16.4" r="1" fill="currentColor" stroke="none"/>',
  ),
  clock: S('<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>'),
  chat: S(
    '<path d="M21 11.5a7.5 7.5 0 01-10.9 6.7L4 20l1.8-5A7.5 7.5 0 1121 11.5z"/>',
  ),
  team: S(
    '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 20a5.5 5.5 0 0111 0M16 6.5a3 3 0 010 5.6M18.5 20a5.5 5.5 0 00-3-4.9"/>',
  ),
  chart: S('<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>'),
  users: S(
    '<rect x="3" y="4" width="18" height="17" rx="3"/><path d="M8 2.5v3M16 2.5v3M12 11.5a2.2 2.2 0 100-4.4 2.2 2.2 0 000 4.4zM8 17.5a4 4 0 018 0"/>',
  ),
};

const feats = [
  {
    ic: "clock",
    t: "Онлайн-запис 24/7",
    d: "Клієнти записуються коли їм зручно, навіть вночі",
  },
  {
    ic: "chat",
    t: "SMS та Email нагадування",
    d: "Автоматичні нагадування зменшують неявки на 40%",
  },
  {
    ic: "team",
    t: "Управління персоналом",
    d: "Розклад, відпустки, навантаження — все в одному місці",
  },
  {
    ic: "chart",
    t: "Аналітика в реальному часі",
    d: "Дохід, завантаженість, популярні послуги — наочно",
  },
  {
    ic: "users",
    t: "Клієнтська база",
    d: "Історія відвідувань, переваги, нотатки по кожному клієнту",
  },
];

const chaos = [
  { t: "09:00", n: "Стрижка?", c: "#F2A2C0", top: 2, h: 40, off: 0 },
  { t: "09:30", n: "Манікюр — Ірина", c: "#A8C9F0", top: 30, h: 44, off: 38 },
  { t: "10:00", n: "Фарбування", c: "#F7C98B", top: 66, h: 50, off: 10 },
  { t: "11:00", n: "?? педикюр", c: "#B6E3B0", top: 108, h: 38, off: 52 },
  { t: "11:30", n: "Брови (уточнити)", c: "#D3B8F2", top: 136, h: 42, off: 4 },
];

const clean = [
  {
    t: "09:00",
    s: "Стрижка + укладка",
    c: "Олена",
    m: "Аня",
    col: "#A78BFA",
    st: "ok",
  },
  {
    t: "10:30",
    s: "Манікюр гель",
    c: "Ірина",
    m: "Віка",
    col: "#F9A8D4",
    st: "rem",
  },
  {
    t: "12:00",
    s: "Фарбування",
    c: "Софія",
    m: "Аня",
    col: "#7DD3FC",
    st: "new",
  },
  {
    t: "14:30",
    s: "Чоловіча стрижка",
    c: "Андрій",
    m: "Олег",
    col: "#86EFAC",
    st: "ok",
  },
];

const staff = [
  { n: "Аня", c: "#A78BFA" },
  { n: "Віка", c: "#F9A8D4" },
  { n: "Олег", c: "#86EFAC" },
];
---

<section class="organize-sec">
  <div class="organize">
    <div class="organize-in">
      <div class="organize-tx">
        <h2 class="dis">Ефективна організація дня</h2>
        <p>
          Перетворіть хаотичний графік на чітко організований робочий процес —
          Zapys24 веде записи, нагадує клієнтам і тримає статуси під контролем.
        </p>
      </div>

      <div class="oz-feats">
        {
          feats.map((f) => (
            <div class="oz-feat">
              <span class="oz-feat-ic" set:html={ic[f.ic]} />
              <div class="oz-feat-tx">
                <b>{f.t}</b>
                <i>{f.d}</i>
              </div>
            </div>
          ))
        }
      </div>

      <div class="oz-cta">
        <a class="org-btn" href="#" data-signup
          >Почати безкоштовно<span class="org-ar"
            ><svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
            ></span
          ></a
        >
      </div>

      <div class="oz-scene">
        <div class="oz-col oz-before">
          <span class="oz-lbl oz-lbl-bad"
            ><i set:html={ic.alert} />Без системи</span
          >
          <div class="oz-paper">
            <div class="oz-paper-h">
              <b>Понеділок</b><span>записів: ~11?</span>
            </div>
            <div class="oz-grid">
              {
                ["09", "10", "11", "12"].map((h) => (
                  <div class="oz-hour">
                    <span>{h}:00</span>
                    <i />
                  </div>
                ))
              }
              {
                chaos.map((b) => (
                  <span
                    class="oz-blk"
                    style={`background:${b.c};top:${b.top}px;height:${b.h}px;margin-left:${b.off}px`}
                  >
                    <b>{b.t}</b>
                    {b.n}
                  </span>
                ))
              }
            </div>
          </div>

          <span class="oz-note oz-n1">Передзвонити</span>
          <span class="oz-note oz-n2">Перенесено</span>
          <span class="oz-note oz-n3">Не прийшов</span>

          <span class="oz-call oz-c1"
            ><i set:html={ic.phone} />Вхідний · +380 67…</span
          >
          <span class="oz-call oz-c2"><i set:html={ic.phone} />3 пропущені</span
          >
        </div>

        <div class="oz-col oz-after">
          <span class="oz-lbl oz-lbl-ok"><i set:html={ic.check} />Zapys24</span>
          <div class="oz-app">
            <div class="oz-app-h">
              <span class="oz-app-t"
                ><i set:html={ic.cal} />Сьогодні · 18 записів</span
              >
              <span class="oz-app-tabs"><b>День</b><span>Тиждень</span></span>
            </div>
            <div class="oz-legend">
              {
                staff.map((s) => (
                  <span class="oz-leg">
                    <i style={`background:${s.c}`} />
                    {s.n}
                  </span>
                ))
              }
            </div>
            <div class="oz-rows">
              {
                clean.map((r) => (
                  <div class="oz-row">
                    <span class="oz-bar" style={`background:${r.col}`} />
                    <span class="oz-tm">{r.t}</span>
                    <span class="oz-tx">
                      <b>{r.s}</b>
                      <i>
                        {r.c} · майстер {r.m}
                      </i>
                    </span>
                    {r.st === "ok" && (
                      <span class="oz-st ok">
                        <i set:html={ic.check} />
                        Запис підтверджено
                      </span>
                    )}
                    {r.st === "rem" && (
                      <span class="oz-st rem">
                        <i set:html={ic.bell} />
                        Нагадування про запис
                      </span>
                    )}
                    {r.st === "new" && (
                      <span class="oz-st new">Новий запис</span>
                    )}
                  </div>
                ))
              }
            </div>
          </div>

          <div class="oz-toast">
            <span class="oz-toast-ic" set:html={ic.bell} />
            <div class="oz-toast-tx">
              <b>Нагадування надіслано</b><i>Ірині · за 2 год до візиту</i>
            </div>
          </div>
          <span class="oz-chip"><i set:html={ic.clock} />0 неявок сьогодні</span
          >
        </div>
      </div>
    </div>
  </div>
</section>
