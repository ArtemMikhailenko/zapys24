---
const faqs = [
  {
    q: "Чи можна перенести базу клієнтів?",
    a: "Так. Є єкспорт баз з Excel, Google-таблиць чи іншої системи для платних тарифів.",
  },
  {
    q: "Потрібен власний сайт?",
    a: "Ні. Сторінка онлайн-запису створюється автоматично — діліться посиланням або вбудуйте посилання в Instagram чи інші соц. мережі.",
  },
  {
    q: "Ви берете комісію із записів?",
    a: "Жодних відсотків із записів. Ви платите фіксовану підписку, а вся виручка лишається вашою — без прихованих платежів.",
  },
  {
    q: "Наскільки безпечні дані?",
    a: "Дані шифруються та зберігаються на серверах у ЄС. Щоденні бекапи, а доступ — лише у вас і вашої команди. Експорт — будь-коли.",
  },
  {
    q: "Чи є мобільний застосунок?",
    a: "Так, Zapys24 Pro для iOS та Android: розклад, клієнти й сповіщення завжди під рукою у майстрів і адміністратора.",
  },
  {
    q: "А якщо не підійде?",
    a: "14 днів безкоштовно, без прив’язки картки. Не сподобається — просто не продовжуєте, а дані віддамо.",
  },
  {
    q: "Чи безкоштовний тариф назавжди?",
    a: "Так! Безкоштовний тариф не має обмежень по часу. Ви можете користуватися ним скільки завгодно з обмеженнями по кількості записів та майстрів.",
  },
  {
    q: "Чи можу я змінити тип бізнесу після реєстрації?",
    a: "Ні, ви можете створити новий тип бізнесу за напрямком. Інтерфейс адаптується під специфіку вашого бізнесу. І ви керуєте двома різними бізнесами незалежно с одного інтерфейсу перемикаючи їх",
  },
  {
    q: "Чи потрібна кредитна картка для старту?",
    a: "Ні! Для безкоштовного тарифу картка не потрібна. Ви можете почати користуватися платформою одразу після реєстрації.",
  },
  {
    q: "Як клієнти записуються до мене?",
    a: "Ви отримуєте унікальне посилання для запису, яке можна розміщувати в соцмережах, на сайті або в Google Maps. Також ваш бізнес автоматично з’являється в мобільному додатку Zapys24.",
  },
  {
    q: "Чи є технічна підтримка?",
    a: "Так! На всіх тарифах доступна підтримка. Free — email (1–2 дні), Standard — пріоритетна підтримка (до 24 год), Premium — виділений менеджер.",
  },
];
// Two orbits keep 11 pills clear of each other: 6 on the outer ring (every 60°),
// the rest on the inner one (every 72°, offset half a step). % of the square stage.
const OUTER = { r: 48, n: 6, start: -90 };
const INNER = { r: 28, start: -54 };
const point = (r: number, ang: number) => {
  const a = (ang * Math.PI) / 180;
  const t = 50 + r * Math.sin(a);
  return {
    l: `${(50 + r * Math.cos(a)).toFixed(2)}%`,
    t: `${t.toFixed(2)}%`,
    up: t > 52, // below the centre → the answer opens upwards
  };
};
const innerN = faqs.length - OUTER.n;
const pos = faqs.map((_, i) =>
  i < OUTER.n
    ? point(OUTER.r, OUTER.start + (360 / OUTER.n) * i)
    : point(INNER.r, INNER.start + (360 / innerN) * (i - OUTER.n)),
);
const dots = Array.from({ length: 6 }, (_, i) => point(38, -60 + 60 * i));
---

<section class="sec wrap reveal faqsec" id="faq">
  <div class="faq-head">
    <div class="kicker">FAQ</div>
    <h2 class="sh">
      Відповіді<br />на питання,<br /><span class="ac">які важливі</span>
    </h2>
    <p class="sub2">Коротко про головне.<br />Без зайвої води.</p>
    <div class="faq-deco" aria-hidden="true">
      <span class="faq-face f1" style="background-image:url(/img/faq1.webp)"
      ></span><span
        class="faq-face f2"
        style="background-image:url(/img/faq2.webp)"></span><span
        class="faq-face f3"
        style="background-image:url(/img/faq3.webp)"></span>
    </div>
  </div>

  <div class="faq-stage">
    <svg
      class="faq-rings"
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <circle class="ring" cx="50" cy="50" r="42"></circle>
      <circle class="ring" cx="50" cy="50" r="27"></circle>
    </svg>
    {dots.map((d) => <span class="faq-dot" style={`left:${d.l};top:${d.t}`} />)}
    <div class="faq-orb"><span>FAQ</span></div>
    {
      faqs.map((f, i) => (
        <div
          class={`faqp${pos[i].up ? " up" : ""}`}
          data-i={i}
          style={`left:${pos[i].l};top:${pos[i].t}`}
        >
          <button class="faqp-head" aria-expanded="false">
            <span class="faqp-q">{f.q}</span>
            <span class="faqp-plus">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
              >
                <path d="M12 6v12M6 12h12" />
              </svg>
            </span>
          </button>
          <div class="faqp-ans">
            <p>{f.a}</p>
          </div>
        </div>
      ))
    }
  </div>

  <div class="faq-foot">
    <div class="faq-ask">
      <p class="hand faq-ask-q">Не знайшли відповідь?</p>
      <a class="hand faq-ask-link" href="/napysaty#form">Напишіть нам</a>
      <svg class="faq-ask-ar" viewBox="0 0 70 40" fill="none" aria-hidden="true"
        ><path
          d="M4,10 C20,30 44,32 64,24"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"></path><path
          d="M64,24 l-13,-2 M64,24 l-3,13"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"></path></svg
      >
    </div>
    <a class="faq-chat" href="#"
      ><span class="faq-chat-ic"
        ><svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="M21 11.5a7.5 7.5 0 01-10.9 6.7L4 20l1.8-5A7.5 7.5 0 1121 11.5z"
          ></path></svg
        ></span
      >Чат з підтримкою</a
    >
  </div>
</section>

<script>
  const pills = Array.from(document.querySelectorAll<HTMLElement>(".faqp"));
  let openI = -1;

  function apply() {
    pills.forEach((p) => {
      const open = Number(p.dataset.i) === openI;
      p.classList.toggle("open", open);
      const h = p.querySelector(".faqp-head");
      if (h) h.setAttribute("aria-expanded", open ? "true" : "false");
    });
  }

  pills.forEach((p) => {
    const h = p.querySelector(".faqp-head");
    const i = Number(p.dataset.i);
    if (h)
      h.addEventListener("click", () => {
        openI = openI === i ? -1 : i;
        apply();
      });
  });
</script>
