---
const services = [
  { n: "Стрижка", p: "300₴" },
  { n: "Манікюр", p: "250₴" },
  { n: "Фарбування", p: "800₴" },
];
const masters = [
  { n: "Олена", r: "Перукар", img: "quote.webp" },
  { n: "Марія", r: "Косметолог", img: "model.webp" },
  { n: "Андрій", r: "Барбер", img: "p1.webp" },
];
const today = new Intl.DateTimeFormat("uk-UA", {
  day: "numeric",
  month: "long",
}).format(new Date());
const ic = {
  upload:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"/><path d="M14 3v5h5"/><path d="M12 18v-5M9.5 15l2.5-2.5 2.5 2.5"/></svg>',
  spark:
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3l1.6 4.7L18 9.3l-4.4 1.6L12 16l-1.6-5.1L6 9.3l4.4-1.6z"/></svg>',
  grip: '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="6" r="1.5"/><circle cx="15" cy="6" r="1.5"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="9" cy="18" r="1.5"/><circle cx="15" cy="18" r="1.5"/></svg>',
  plus: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 6v12M6 12h12"/></svg>',
  check:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg>',
  cal: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/></svg>',
  user: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.4"/><path d="M5.5 20a6.5 6.5 0 0113 0"/></svg>',
  link: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 007.5.5l2-2a5 5 0 00-7-7l-1.2 1.1M14 11a5 5 0 00-7.5-.5l-2 2a5 5 0 007 7l1.2-1.1"/></svg>',
  copy: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2.5"/><path d="M5 15V5a2 2 0 012-2h10"/></svg>',
  bell: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 01-3.4 0"/></svg>',
  person:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.4"/><path d="M5.5 20a6.5 6.5 0 0113 0"/></svg>',
  insta:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor" stroke="none"/></svg>',
};
---

<section class="sec wrap reveal hiwsec">
  <div class="hiw-head">
    <div class="kicker">Як це працює</div>
    <h2 class="sh">Перший запис — за <span class="ac">3 кроки</span></h2>
    <p class="sub2">
      Без складного налаштування — від старту до першого онлайн-запису за кілька
      хвилин.
    </p>
    <div class="znote hiw-note">
      <p class="hand">готово за<br />5 хвилин</p><span class="zar"
        ><svg viewBox="0 0 118 82" fill="none" aria-hidden="true"
          ><path
            d="M108 14 C64 6 22 22 15 60"
            stroke="var(--violet)"
            stroke-width="2.2"
            stroke-linecap="round"></path><path
            d="M15 60 l3 -17 M15 60 l16 -6"
            stroke="var(--violet)"
            stroke-width="2.2"
            stroke-linecap="round"></path></svg
        ></span
      >
    </div>
  </div>

  <div class="hiw-grid">
    <svg
      class="hiw-wire"
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path class="hwire" d="M29,46 C33,30 35,29 38.5,33"></path>
      <path class="hwire" d="M61.5,33 C65,29 67,30 71,46"></path>
    </svg>
    <span class="hiw-dot" style="left:44%;top:21%"></span>
    <span class="hiw-dot" style="left:56%;top:21%"></span>
    <span class="hiw-dot" style="left:50%;top:60%"></span>
    <span class="hconn hconn-1" set:html={ic.person} />
    <span class="hconn hconn-2" set:html={ic.check} />

    <article class="hcard">
      <header class="hcard-h">
        <span class="hnum">1</span><div class="hcard-t">
          <b>Створіть бізнес</b><p>
            Додайте назву, контакти — і можна починати.
          </p>
        </div>
      </header>
      <div class="hmock">
        <div class="hmock-top">
          <span class="hmt-ic" set:html={ic.upload} />Новий кабінет<span
            class="hmt-spark"
            set:html={ic.spark}
          />
        </div>
        <div class="hfield">
          <label>Назва бізнесу</label><div class="hinput">
            Студія краси "Гламур"
          </div>
        </div>
        <div class="hfield">
          <label>Телефон</label><div class="hinput">+380 50 123 45 67</div>
        </div>
        <div class="hfield">
          <label>Адреса</label><div class="hinput">
            вул. Хрещатик, 22, Київ
          </div>
        </div>
        <a class="hbtn" href="#" data-signup>Створити бізнес</a>
      </div>
    </article>

    <article class="hcard">
      <header class="hcard-h">
        <span class="hnum">2</span><div class="hcard-t">
          <b>Додайте послуги й співробітників</b><p>
            Налаштуйте ціни, тривалість і графік роботи персоналу та закріпіть
            посилання у шапці профілю соц. мереж.
          </p>
        </div>
      </header>
      <div class="hmock">
        <div class="hmock-lbl">Послуги</div>
        <div class="hsvc">
          {
            services.map((s) => (
              <span class="hsvc-p">
                <i class="grip" set:html={ic.grip} />
                {s.n}
                <b>{s.p}</b>
              </span>
            ))
          }
          <span class="hsvc-add"><i set:html={ic.plus} />Додати послугу</span>
        </div>
        <div class="hmock-lbl hmock-lbl2">Майстри</div>
        <div class="hmasters">
          {
            masters.map((m) => (
              <div class="hmaster">
                <>
                  <span
                    class="hm-av"
                    style={`background-image:url(/img/${m.img})`}
                  />
                  <b>{m.n}</b>
                  <i>{m.r}</i>
                </>
              </div>
            ))
          }
          <span class="hmaster-add" set:html={ic.plus} />
        </div>
      </div>
    </article>

    <article class="hcard">
      <header class="hcard-h">
        <span class="hnum">3</span><div class="hcard-t">
          <b>Отримайте перший запис</b><p>
            Клієнт переходить за посіланням та бронюється сам, а запис одразу
            з’являється в системі.
          </p>
        </div>
      </header>
      <div class="hmock hmock-green">
        <div class="hbk-h">
          <span class="hbk-check" set:html={ic.check} /><div>
            <b>Новий запис!</b><i>Сьогодні, 14:30</i>
          </div>
        </div>
        <div class="hbk-client">
          <span class="hbk-av" style="background-image:url(/img/anna.webp)"
          ></span><div><b>Анна Ковальська</b><i>Чищення обличчя</i></div>
        </div>
        <div class="hbk-meta">
          <span><i set:html={ic.cal} />{today}, 14:30</span><span
            ><i set:html={ic.user} />Марія</span
          >
        </div>
        <a class="hbtn hbtn-out" href="#" data-signup="demo"
          >Перейти до розкладу</a
        >
      </div>
    </article>
  </div>

  <div class="hig">
    <div class="hig-bar">
      <span class="hig-ig" set:html={ic.insta} /><b>charivna.salon</b>
    </div>
    <div class="hig-top">
      <span class="hig-ring"
        ><span class="hig-av" style="background-image:url(/img/salon.png)"
        ></span></span
      >
      <div class="hig-stats">
        <span><b>128</b>дописів</span><span><b>4 312</b>читачів</span><span
          ><b>310</b>стежить</span
        >
      </div>
    </div>
    <div class="hig-bio">
      <b>Студія краси «Гламур»</b>
      <p>Стрижки · колор · манікюр<br />вул. Хрещатик, 22, Київ</p>
      <a
        class="hig-link"
        href="https://demo.zapys24.com/book/glamur"
        target="_blank"
        rel="noopener"
        ><span set:html={ic.link} />beauty.zapys24.com/book/glamur</a
      >
    </div>
    <a
      class="hig-cta"
      href="https://demo.zapys24.com/book/glamur"
      target="_blank"
      rel="noopener">Записатись онлайн</a
    >
  </div>
  <div class="hchip hchip-done">
    <span class="hchip-ic green" set:html={ic.check} /><div class="hchip-tx">
      <b>Бізнес створено</b><i>Усе готово до налаштування</i>
    </div>
  </div>
  <a
    class="hchip hchip-url"
    href="https://demo.zapys24.com/book/glamur"
    target="_blank"
    rel="noopener"
  >
    <span
      class="hchip-ic"
      set:html={ic.link}
    />beauty.zapys24.com/book/glamur<span
      class="hchip-copy"
      set:html={ic.copy}
    />
  </a>
  <div class="hchip hchip-notif">
    <span class="hchip-ic violet" set:html={ic.bell} /><div class="hchip-tx">
      <span class="hn-top"><b>Zapys24</b><i>зараз</i></span><p>
        Новий запис: Анна Ковальська
      </p>
    </div>
  </div>
  <!-- <svg class="hiw-arrow" viewBox="0 0 80 54" fill="none" aria-hidden="true"><path d="M4,20 C24,6 50,8 72,30" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path><path d="M72,30 l-15,-3 M72,30 l-3,15" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg> -->
</section>
