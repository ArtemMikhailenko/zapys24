---
/* Копия public/img/logo-with-text.svg. Инлайн — чтобы id градиентов были
   уникальны на инстанс (nav и footer рендерят логотип на одной странице)
   и чтобы текст можно было перекрасить в белый на тёмном футере. */
const { class: cls } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---

<svg
  class={cls ? `logo-svg ${cls}` : "logo-svg"}
  xmlns="http://www.w3.org/2000/svg"
  width="500"
  height="100"
  viewBox="0 0 500 100"
  role="img"
  aria-label="Zapys24 — онлайн-запис для бізнесу"
>
  <defs>
    <radialGradient id={`lt-bg-${uid}`} cx="50%" cy="30%" r="80%">
      <stop offset="0%" stop-color="#A66BFF"></stop>
      <stop offset="55%" stop-color="#8A4DFF"></stop>
      <stop offset="100%" stop-color="#6E36E8"></stop>
    </radialGradient>
    <linearGradient id={`lt-check-${uid}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#A66BFF"></stop>
      <stop offset="100%" stop-color="#6E36E8"></stop>
    </linearGradient>
    <filter id={`lt-sh-${uid}`} x="-10%" y="-10%" width="120%" height="130%">
      <feDropShadow
        dx="0"
        dy="2"
        stdDeviation="3"
        flood-color="#4B1DBB"
        flood-opacity="0.2"></feDropShadow>
    </filter>
  </defs>

  <!-- Icon -->
  <g transform="translate(10,5)">
    <rect
      width="90"
      height="90"
      rx="20"
      fill={`url(#lt-bg-${uid})`}
      filter={`url(#lt-sh-${uid})`}></rect>
    <rect
      x="16"
      y="22"
      width="58"
      height="49"
      rx="8"
      fill="white"
      fill-opacity="0.95"></rect>
    <rect x="16" y="22" width="58" height="15" rx="8" fill="#EDECF0"></rect>
    <rect x="16" y="30" width="58" height="7" fill="#EDECF0"></rect>
    <circle cx="28" cy="30" r="2.8" fill={`url(#lt-check-${uid})`}></circle>
    <circle cx="62" cy="30" r="2.8" fill={`url(#lt-check-${uid})`}></circle>
    <line x1="16" y1="37" x2="74" y2="37" stroke="#D6D6DC" stroke-width="0.8"
    ></line>
    <text
      x="45"
      y="62"
      text-anchor="middle"
      font-family="system-ui, -apple-system, sans-serif"
      font-size="24"
      font-weight="800"
      fill={`url(#lt-check-${uid})`}
      letter-spacing="-1">24</text
    >
    <circle cx="67" cy="63" r="7" fill={`url(#lt-check-${uid})`}></circle>
    <path
      d="M62.5 63 L65 65.5 L71.5 59"
      stroke="white"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"></path>
  </g>

  <!-- Brand name -->
  <text
    class="logo-svg-name"
    x="120"
    y="42"
    font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    font-size="36"
    font-weight="800"
    fill="#1e1b2e"
    letter-spacing="-1">Zapys</text
  >
  <text
    class="logo-svg-num"
    x="247"
    y="42"
    font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    font-size="36"
    font-weight="800"
    fill="#7c3aed"
    letter-spacing="-1">24</text
  >

  <!-- Tagline -->
  <text
    class="logo-svg-tag"
    x="120"
    y="72"
    font-family="system-ui, -apple-system, sans-serif"
    font-size="24"
    font-weight="500"
    fill="#94a3b8"
    letter-spacing="0.3">Онлайн-запис для бізнесу</text
  >
</svg>
